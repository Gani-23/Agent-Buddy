<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Motion system
        - Entrance: cards rise + fade in when a view is shown (FillMode=Backward so the
          base RenderTransform comes back after the animation and hover lifts keep working).
        - Stagger: add Classes="Stagger DelayN" (N=1..6) to a card to offset its entrance.
        - Hover: lift + deeper shadow; Press: slight scale-down.
    -->

    <Styles.Resources>
        <x:Double x:Key="DefaultTransitionDuration">0.3</x:Double>
        <x:Double x:Key="FastTransitionDuration">0.2</x:Double>
        <x:Double x:Key="SlowTransitionDuration">0.4</x:Double>
    </Styles.Resources>

    <!-- ============================================ -->
    <!-- CARD ENTRANCE (rise + fade)                   -->
    <!-- ============================================ -->
    <Style Selector="Border.Card:not(.Stagger), Border.SectionCard:not(.Stagger), Border.StatTile:not(.Stagger), Border.DefaultSummaryCard:not(.Stagger), Border.MetricCard:not(.Stagger), Border.DashboardHeader:not(.Stagger), Border.DialogSurface:not(.Stagger), Control.FadeUp:not(.Stagger)">
        <Style.Animations>
            <Animation Duration="0:0:0.32" FillMode="Backward" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="RenderTransform" Value="translateY(8px)"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="RenderTransform" Value="translateY(0px)"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Stagger delays -->
    <Style Selector="Control.Stagger.Delay1">
        <Style.Animations>
            <Animation Duration="0:0:0.32" Delay="0:0:0.03" FillMode="Backward" Easing="CubicEaseOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="RenderTransform" Value="translateY(8px)"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="RenderTransform" Value="translateY(0px)"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Control.Stagger.Delay2">
        <Style.Animations>
            <Animation Duration="0:0:0.32" Delay="0:0:0.06" FillMode="Backward" Easing="CubicEaseOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="RenderTransform" Value="translateY(8px)"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="RenderTransform" Value="translateY(0px)"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Control.Stagger.Delay3">
        <Style.Animations>
            <Animation Duration="0:0:0.32" Delay="0:0:0.09" FillMode="Backward" Easing="CubicEaseOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="RenderTransform" Value="translateY(8px)"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="RenderTransform" Value="translateY(0px)"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Control.Stagger.Delay4">
        <Style.Animations>
            <Animation Duration="0:0:0.32" Delay="0:0:0.12" FillMode="Backward" Easing="CubicEaseOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="RenderTransform" Value="translateY(8px)"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="RenderTransform" Value="translateY(0px)"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Control.Stagger.Delay5">
        <Style.Animations>
            <Animation Duration="0:0:0.32" Delay="0:0:0.15" FillMode="Backward" Easing="CubicEaseOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="RenderTransform" Value="translateY(8px)"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="RenderTransform" Value="translateY(0px)"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Control.Stagger.Delay6">
        <Style.Animations>
            <Animation Duration="0:0:0.32" Delay="0:0:0.18" FillMode="Backward" Easing="CubicEaseOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="RenderTransform" Value="translateY(8px)"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="RenderTransform" Value="translateY(0px)"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================ -->
    <!-- FADE IN / SLIDE IN (legacy helpers)           -->
    <!-- ============================================ -->
    <Style Selector="Control.FadeIn">
        <Style.Animations>
            <Animation Duration="0:0:0.3" FillMode="Backward">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Control.SlideInLeft">
        <Style.Animations>
            <Animation Duration="0:0:0.35" FillMode="Backward" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="RenderTransform" Value="translateX(-24px)"/>
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RenderTransform" Value="translateX(0px)"/>
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================ -->
    <!-- HOVER LIFT                                    -->
    <!-- ============================================ -->
    <Style Selector="Border.Hoverable">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.22"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.Hoverable:pointerover">
        <Setter Property="BoxShadow" Value="{DynamicResource AppCardHoverShadow}"/>
    </Style>

    <!-- ============================================ -->
    <!-- SMOOTH PROPERTY TRANSITIONS                   -->
    <!-- ============================================ -->
    <Style Selector="TextBlock.Smooth">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.Smooth">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                <ThicknessTransition Property="BorderThickness" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!-- LOADING SPINNER                               -->
    <!-- ============================================ -->
    <Style Selector="Control.Spinner">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Style.Animations>
            <Animation Duration="0:0:0.9" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="RenderTransform" Value="rotate(0deg)"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="RenderTransform" Value="rotate(360deg)"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================ -->
    <!-- PULSE (notifications / attention)             -->
    <!-- ============================================ -->
    <Style Selector="Border.Pulse">
        <Style.Animations>
            <Animation Duration="0:0:1.6" IterationCount="Infinite" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.55"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Live dot: soft breathing scale for status indicators -->
    <Style Selector="Border.LiveDot">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Style.Animations>
            <Animation Duration="0:0:1.8" IterationCount="Infinite" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="RenderTransform" Value="scale(1)"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="RenderTransform" Value="scale(1.35)"/><Setter Property="Opacity" Value="0.6"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="RenderTransform" Value="scale(1)"/><Setter Property="Opacity" Value="1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Skeleton shimmer for loading placeholders -->
    <Style Selector="Border.Skeleton">
        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Style.Animations>
            <Animation Duration="0:0:1.2" IterationCount="Infinite" Easing="SineEaseInOut" PlaybackDirection="Alternate">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.45"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

</Styles>
