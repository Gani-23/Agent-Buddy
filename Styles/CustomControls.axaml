<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <Border Padding="20" Background="{DynamicResource AppBackgroundBrush}">
            <StackPanel Spacing="10">
                <Button Classes="Primary" Content="Primary Button"/>
                <Button Classes="Secondary" Content="Secondary Button"/>
                <Border Classes="Card" Padding="20">
                    <TextBlock Text="Card Content"/>
                </Border>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- Typography baseline -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="UserControl">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
    </Style>

    <!-- Ensure labels and icons inside buttons inherit colors and align centered -->
    <Style Selector="Button TextBlock">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button PathIcon">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button Grid">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button StackPanel">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.Kicker">
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style Selector="TextBlock.SubHeader">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="26"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style Selector="TextBlock.DialogTitle">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="30"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style Selector="TextBlock.SectionLead">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.DialogBody">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.MetricValue">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LineHeight" Value="34"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style Selector="DatePicker">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="DatePicker /template/ Button#PART_FlyoutButton">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BoxShadow" Value="{DynamicResource AppInsetShadow}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BoxShadow" Value="{DynamicResource AppFocusRingShadow}"/>
    </Style>

    <Style Selector="TextBox:pointerover:not(:focus) /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource InfoEdgeBrush}"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style Selector="ComboBox.ModeSelector">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
    </Style>

    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource AppPressedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource ToolTipBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ToolTipBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ToolTipForegroundBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource ToolTipFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource ToolTipFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MaxWidth" Value="420"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ToolTip /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource ToolTipBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ToolTipBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AppCardHoverShadow}"/>
    </Style>

    <Style Selector="ToolTip ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource ToolTipForegroundBrush}"/>
        <Setter Property="TextBlock.FontFamily" Value="{DynamicResource ToolTipFontFamily}"/>
        <Setter Property="TextBlock.FontSize" Value="{DynamicResource ToolTipFontSize}"/>
        <Setter Property="TextBlock.FontWeight" Value="Normal"/>
        <Setter Property="TextBlock.LineHeight" Value="17"/>
        <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="ToolTip TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ToolTipForegroundBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource ToolTipFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource ToolTipFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LineHeight" Value="17"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="ToolTip PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ToolTipForegroundBrush}"/>
    </Style>

    <!-- Modern Clean Cards -->
    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AppCardShadow}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.SectionCard">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AppCardShadow}"/>
    </Style>

    <Style Selector="Border.DefaultSummaryCard">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AppCardShadow}"/>
    </Style>

    <Style Selector="Border.DialogBackdrop">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style Selector="Border.DialogSurface">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="22"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AppCardLiftShadow}"/>
    </Style>

    <Style Selector="ToggleButton.Icon">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="ToggleButton.Icon /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource AppButtonShadow}"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="ToggleButton.Icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
    </Style>

    <Style Selector="ToggleButton.Icon:checked">
        <Setter Property="Background" Value="{DynamicResource AppPressedBrush}"/>
    </Style>

    <Style Selector="ToggleButton.Icon:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource AppButtonPressedShadow}"/>
    </Style>

    <Style Selector="Border.DialogDivider">
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="Border.DialogDot">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.StatTile">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BoxShadow" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.StatTile:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AppCardHoverShadow}"/>
    </Style>

    <!-- Small status dot that carries the tile's meaning instead of a colored edge -->
    <Style Selector="Border.TileDot">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource AppTextSecondaryBrush}"/>
    </Style>

    <!-- Big number inside a stat tile -->
    <Style Selector="Border.StatTile TextBlock.TileValue">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="-0.4"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style Selector="Border.StatTile TextBlock.TileTitle">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
    </Style>

    <Style Selector="Border.TintDanger">
        <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
    </Style>

    <Style Selector="Border.TintWarning">
        <Setter Property="Background" Value="{DynamicResource WarningTintBrush}"/>
    </Style>

    <Style Selector="Border.TintSuccess">
        <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}"/>
    </Style>

    <Style Selector="Border.TintInfo">
        <Setter Property="Background" Value="{DynamicResource InfoTintBrush}"/>
    </Style>

    <Style Selector="Border.ListSpinner">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    </Style>

    <Style Selector="Border.Card.Hoverable:pointerover">
        <Setter Property="BoxShadow" Value="{DynamicResource AppCardHoverShadow}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}"/>
    </Style>

    <!-- Modern Buttons with Subtle Elevation -->
    <Style Selector="Button">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource AppButtonShadow}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}"/>
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource AppPressedBrush}"/>
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="none"/>
    </Style>

    <Style Selector="Button.Primary">
        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.Primary:pointerover">
        <Setter Property="Background" Value="{StaticResource AccentBlueHoverBrush}"/>
    </Style>

    <!-- Main call-to-action: solid accent, same as Primary -->
    <Style Selector="Button.Hero">
        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.Hero:pointerover">
        <Setter Property="Background" Value="{StaticResource AccentBlueHoverBrush}"/>
    </Style>

    <Style Selector="Button.Success">
        <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.Success:pointerover">
        <Setter Property="Background" Value="{StaticResource AccentGreenHoverBrush}"/>
    </Style>

    <Style Selector="Button.Danger">
        <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.Danger:pointerover">
        <Setter Property="Background" Value="{StaticResource AccentRedHoverBrush}"/>
    </Style>

    <Style Selector="Button.Secondary">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.Secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
    </Style>

    <Style Selector="Button.Icon">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Button.Icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
    </Style>

    <!-- Navigation Item Button (Sidebar) -->
    <Style Selector="Button.NavItem">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.NavItem PathIcon">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="BackEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.NavItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="none"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Button.NavItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
    </Style>

    <Style Selector="Button.NavItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="none"/>
    </Style>

    <Style Selector="Button.NavItem.Current">
        <Setter Property="Background" Value="{DynamicResource InfoTintBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.NavItem.Current PathIcon">
        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
    </Style>

    <Style Selector="Button.NavItem.Current /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="none"/>
    </Style>

    <Style Selector="TextBox.Notion">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="TextBox.Notion:focus">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
    </Style>

    <Style Selector="TextBlock.SectionHeader">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="LineHeight" Value="32"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style Selector="Border.StatusChip">
        <Setter Property="Background" Value="{DynamicResource AppSidebarBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AppInputShadow}"/>
    </Style>

    <Style Selector="Border.MetricCard">
        <Setter Property="Background" Value="{DynamicResource AppSidebarBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="BoxShadow" Value="0 1 2 0 #0000000A"/>
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="Margin" Value="0,6"/>
    </Style>

    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppBorderBrush}"/>
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource AppSidebarBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style Selector="DataGridRow">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="DataGridRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
    </Style>

    <Style Selector="DataGridRow:selected">
        <Setter Property="Background" Value="{DynamicResource InfoTintBrush}"/>
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Modern Badge / Pill Classes -->
    <Style Selector="Border.Badge">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource AppSidebarBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
    </Style>

    <Style Selector="Border.Badge TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Border.Badge.Ready">
        <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
    </Style>

    <Style Selector="Border.Badge.Review">
        <Setter Property="Background" Value="{DynamicResource WarningTintBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentYellowBrush}"/>
    </Style>

    <Style Selector="Border.Badge.Blocked">
        <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
    </Style>

    <Style Selector="Border.Badge.Idle">
        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="MinHeight" Value="6"/>
    </Style>

    <!-- Icon chip used on cards / headers -->
    <Style Selector="Border.IconChip">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource InfoTintBrush}"/>
    </Style>
    <Style Selector="Border.IconChip.Brand">
        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Stat tiles stay neutral; the Tint* class only colors the status dot -->
    <Style Selector="Border.StatTile.TintSuccess, Border.StatTile.TintWarning, Border.StatTile.TintDanger, Border.StatTile.TintInfo">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.StatTile.TintSuccess Border.TileDot">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
    </Style>
    <Style Selector="Border.StatTile.TintWarning Border.TileDot">
        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
    </Style>
    <Style Selector="Border.StatTile.TintDanger Border.TileDot">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
    </Style>
    <Style Selector="Border.StatTile.TintInfo Border.TileDot">
        <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
    </Style>

    <!-- Compact ghost buttons on tiles -->
    <Style Selector="Border.StatTile Button.Secondary">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Border.StatTile Button.Secondary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="Border.StatTile Button.Secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppPressedBrush}"/>
    </Style>

    <!-- ===== Dashboard building blocks ===== -->
    <Style Selector="TextBlock.TileMeta">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Border.StatTile TextBlock.TileLink">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.StatTile:pointerover TextBlock.TileLink">
        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
    </Style>

    <!-- Clickable cards -->
    <Style Selector="Border.StatTile[Focusable=True], Border.Metric.Clickable">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.StatTile:focus-visible, Border.Metric.Clickable:focus-visible">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AppFocusRingShadow}"/>
    </Style>

    <!-- Today cards: the current deadline gets an accent outline and a "Due now" pill -->
    <Style Selector="Border.TodayCard.DueNow">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="Background" Value="{DynamicResource InfoTintBrush}"/>
    </Style>
    <Style Selector="Border.NowPill">
        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>
    <Style Selector="Border.NowPill TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Border.StatTile Button.TileAction">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.StatTile Button.Secondary.TileAction">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
    </Style>
    <Style Selector="Border.StatTile Button.Secondary.TileAction:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
    </Style>
    <Style Selector="Border.StatTile Button.Secondary.TileAction /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.TileMenu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.TileMenu /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="none"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.TileMenu:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>

    <!-- Portfolio metrics -->
    <Style Selector="Border.Metric">
        <Setter Property="Padding" Value="14"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.Metric.Clickable:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}"/>
    </Style>
    <Style Selector="TextBlock.MetricLabel">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
    </Style>
    <Style Selector="Border.Metric TextBlock.MetricValue">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="-0.6"/>
        <Setter Property="LineHeight" Value="32"/>
    </Style>

    <!-- Inline text button -->
    <Style Selector="Button.LinkButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.LinkButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="Button.LinkButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource InfoTintBrush}"/>
    </Style>

    <!-- Visible keyboard focus everywhere -->
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource AppFocusRingShadow}"/>
    </Style>

</Styles>
