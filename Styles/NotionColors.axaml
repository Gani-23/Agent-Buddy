<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Font Families (Cross-platform MacOS/Windows/Linux) -->
        <FontFamily x:Key="AppFontFamily">-apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Segoe UI", Roboto, "Helvetica Neue", Inter, Arial, sans-serif</FontFamily>
        <FontFamily x:Key="AppMonoFontFamily">"SF Mono", Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace</FontFamily>

        <!-- Notion-inspired neutrals -->
        <Color x:Key="LightBackground">#F7F6F3</Color>
        <Color x:Key="LightCardBackground">#FFFFFF</Color>
        <Color x:Key="LightSidebarBackground">#FBFAF8</Color>
        <Color x:Key="LightTextPrimary">#2F3437</Color>
        <Color x:Key="LightTextSecondary">#6B7280</Color>
        <Color x:Key="LightBorder">#E7E5E4</Color>
        <Color x:Key="LightHover">#F1F0EE</Color>
        <Color x:Key="LightPressed">#E8E7E5</Color>

        <Color x:Key="DarkBackground">#171717</Color>
        <Color x:Key="DarkCardBackground">#202020</Color>
        <Color x:Key="DarkSidebarBackground">#1B1B1B</Color>
        <Color x:Key="DarkTextPrimary">#ECECEC</Color>
        <Color x:Key="DarkTextSecondary">#A3A3A3</Color>
        <Color x:Key="DarkBorder">#333333</Color>
        <Color x:Key="DarkHover">#2A2A2A</Color>
        <Color x:Key="DarkPressed">#353535</Color>

        <!-- Accents -->
        <Color x:Key="AccentBlue">#2F76E6</Color>
        <Color x:Key="AccentBlueHover">#235FC2</Color>
        <Color x:Key="AccentGreen">#1F8A62</Color>
        <Color x:Key="AccentGreenHover">#1A7553</Color>
        <Color x:Key="AccentRed">#D94848</Color>
        <Color x:Key="AccentRedHover">#BE3E3E</Color>
        <Color x:Key="AccentYellow">#D4A017</Color>
        <Color x:Key="AccentPink">#C44582</Color>

        <!-- Neumorphic Palette (Default Light Soft UI) -->
        <Color x:Key="NeuLightBackground">#E6ECF5</Color>
        <Color x:Key="NeuLightCard">#E6ECF5</Color>
        <Color x:Key="NeuLightSidebar">#DFE6F0</Color>
        <Color x:Key="NeuLightTextPrimary">#2D3748</Color>
        <Color x:Key="NeuLightTextSecondary">#627289</Color>
        <Color x:Key="NeuLightBorder">#D5DFED</Color>
        <Color x:Key="NeuLightHover">#DDE5F0</Color>
        <Color x:Key="NeuLightPressed">#D3DCE8</Color>

        <!-- Neumorphic Palette (Dark Soft UI) -->
        <Color x:Key="NeuDarkBackground">#1E222B</Color>
        <Color x:Key="NeuDarkCard">#1E222B</Color>
        <Color x:Key="NeuDarkSidebar">#181B22</Color>
        <Color x:Key="NeuDarkTextPrimary">#E2E8F0</Color>
        <Color x:Key="NeuDarkTextSecondary">#8A99AD</Color>
        <Color x:Key="NeuDarkBorder">#2A303C</Color>
        <Color x:Key="NeuDarkHover">#252A35</Color>
        <Color x:Key="NeuDarkPressed">#191C24</Color>

        <!-- Legacy / Fallback keys -->
        <SolidColorBrush x:Key="LightBackgroundBrush" Color="{StaticResource LightBackground}"/>
        <SolidColorBrush x:Key="LightCardBackgroundBrush" Color="{StaticResource LightCardBackground}"/>
        <SolidColorBrush x:Key="LightSidebarBackgroundBrush" Color="{StaticResource LightSidebarBackground}"/>
        <SolidColorBrush x:Key="LightTextPrimaryBrush" Color="{StaticResource LightTextPrimary}"/>
        <SolidColorBrush x:Key="LightTextSecondaryBrush" Color="{StaticResource LightTextSecondary}"/>
        <SolidColorBrush x:Key="LightBorderBrush" Color="{StaticResource LightBorder}"/>
        <SolidColorBrush x:Key="LightHoverBrush" Color="{StaticResource LightHover}"/>
        <SolidColorBrush x:Key="LightPressedBrush" Color="{StaticResource LightPressed}"/>

        <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackground}"/>
        <SolidColorBrush x:Key="DarkCardBackgroundBrush" Color="{StaticResource DarkCardBackground}"/>
        <SolidColorBrush x:Key="DarkSidebarBackgroundBrush" Color="{StaticResource DarkSidebarBackground}"/>
        <SolidColorBrush x:Key="DarkTextPrimaryBrush" Color="{StaticResource DarkTextPrimary}"/>
        <SolidColorBrush x:Key="DarkTextSecondaryBrush" Color="{StaticResource DarkTextSecondary}"/>
        <SolidColorBrush x:Key="DarkBorderBrush" Color="{StaticResource DarkBorder}"/>
        <SolidColorBrush x:Key="DarkHoverBrush" Color="{StaticResource DarkHover}"/>
        <SolidColorBrush x:Key="DarkPressedBrush" Color="{StaticResource DarkPressed}"/>

        <!-- App tokens (Defaulting to Neumorphic Light Soft UI) -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource NeuLightBackground}"/>
        <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="{StaticResource NeuLightCard}"/>
        <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="{StaticResource NeuLightSidebar}"/>
        <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource NeuLightTextPrimary}"/>
        <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource NeuLightTextSecondary}"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource NeuLightBorder}"/>
        <SolidColorBrush x:Key="AppHoverBrush" Color="{StaticResource NeuLightHover}"/>
        <SolidColorBrush x:Key="AppPressedBrush" Color="{StaticResource NeuLightPressed}"/>

        <!-- Neumorphic Shadows (BoxShadow tokens) -->
        <BoxShadows x:Key="NeuCardShadow">-6 -6 14 0 #FFFFFFFF, 6 6 14 0 #30456224</BoxShadows>
        <BoxShadows x:Key="NeuCardHoverShadow">-8 -8 18 0 #FFFFFFFF, 8 8 18 0 #30456230</BoxShadows>
        <BoxShadows x:Key="NeuCardSmallShadow">-4 -4 10 0 #FFFFFFFF, 4 4 10 0 #30456220</BoxShadows>
        <BoxShadows x:Key="NeuInsetShadow">inset 3 3 6 0 #30456228, inset -3 -3 6 0 #FFFFFFFF</BoxShadows>
        <BoxShadows x:Key="NeuButtonShadow">-4 -4 10 0 #FFFFFFFF, 4 4 10 0 #30456224</BoxShadows>
        <BoxShadows x:Key="NeuButtonPressedShadow">inset 3 3 6 0 #30456230, inset -3 -3 6 0 #FFFFFFFF</BoxShadows>
        <BoxShadows x:Key="NeuPillShadow">-3 -3 7 0 #FFFFFFFF, 3 3 7 0 #30456220</BoxShadows>

        <!-- Dynamic BoxShadow resources updated at runtime -->
        <BoxShadows x:Key="AppCardShadow">-6 -6 14 0 #FFFFFFFF, 6 6 14 0 #30456224</BoxShadows>
        <BoxShadows x:Key="AppCardHoverShadow">-8 -8 18 0 #FFFFFFFF, 8 8 18 0 #30456230</BoxShadows>
        <BoxShadows x:Key="AppInsetShadow">inset 3 3 6 0 #30456228, inset -3 -3 6 0 #FFFFFFFF</BoxShadows>
        <BoxShadows x:Key="AppButtonShadow">-4 -4 10 0 #FFFFFFFF, 4 4 10 0 #30456224</BoxShadows>
        <BoxShadows x:Key="AppButtonPressedShadow">inset 3 3 6 0 #30456230, inset -3 -3 6 0 #FFFFFFFF</BoxShadows>

        <SolidColorBrush x:Key="SuccessTintBrush" Color="#D9F0E2"/>
        <SolidColorBrush x:Key="WarningTintBrush" Color="#FCECC7"/>
        <SolidColorBrush x:Key="DangerTintBrush" Color="#FCDCDC"/>
        <SolidColorBrush x:Key="InfoTintBrush" Color="#DBE7FA"/>
        <SolidColorBrush x:Key="TintTextBrush" Color="#2D3748"/>
        <SolidColorBrush x:Key="ListAdvanceTintBrush" Color="#D2E3FC"/>
        <SolidColorBrush x:Key="ListAdvanceBorderBrush" Color="#145BD6"/>
        <SolidColorBrush x:Key="ListCatchUpTintBrush" Color="#FAE8BC"/>
        <SolidColorBrush x:Key="ListCatchUpBorderBrush" Color="#C98B00"/>
        <SolidColorBrush x:Key="ListMixedTintBrush" Color="#C9EFE6"/>
        <SolidColorBrush x:Key="ListMixedBorderBrush" Color="#0B8A6A"/>
        <SolidColorBrush x:Key="ListLongOverdueTintBrush" Color="#F6D6BA"/>
        <SolidColorBrush x:Key="ListLongOverdueBorderBrush" Color="#C56000"/>
        <SolidColorBrush x:Key="ListPartialCatchUpTintBrush" Color="#FCD6D2"/>
        <SolidColorBrush x:Key="ListPartialCatchUpBorderBrush" Color="#E16A5A"/>
        <SolidColorBrush x:Key="ListLongOverduePartialTintBrush" Color="#F7BDB5"/>
        <SolidColorBrush x:Key="ListLongOverduePartialBorderBrush" Color="#A63232"/>
        <SolidColorBrush x:Key="ListMissingDueTintBrush" Color="#E2E7EE"/>
        <SolidColorBrush x:Key="ListMissingDueBorderBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="ListDuplicateTintBrush" Color="#F9D7E8"/>
        <SolidColorBrush x:Key="ListDuplicateBorderBrush" Color="#C44582"/>
        <SolidColorBrush x:Key="SuggestionBorderBrush" Color="#C44582"/>

        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
        <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="{StaticResource AccentBlueHover}"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}"/>
        <SolidColorBrush x:Key="AccentGreenHoverBrush" Color="{StaticResource AccentGreenHover}"/>
        <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}"/>
        <SolidColorBrush x:Key="AccentRedHoverBrush" Color="{StaticResource AccentRedHover}"/>
        <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource AccentYellow}"/>
        <SolidColorBrush x:Key="AccentPinkBrush" Color="{StaticResource AccentPink}"/>

        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource AccentGreen}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource AccentYellow}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource AccentRed}"/>
        <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource AccentBlue}"/>
    </Styles.Resources>

</Styles>
