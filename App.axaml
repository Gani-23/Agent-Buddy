<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:AgentBuddy.Converters"
             x:Class="AgentBuddy.App"
             RequestedThemeVariant="Light">
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Icons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <converters:BoolToThemeIconConverter x:Key="BoolToThemeIconConverter"/>
            <converters:BoolNotConverter x:Key="BoolNotConverter"/>
            <converters:StatusToTagConverter x:Key="StatusToTagConverter"/>
            <converters:ListItemToTagConverter x:Key="ListItemToTagConverter"/>
            <converters:SidebarWidthConverter x:Key="SidebarWidthConverter"/>

            <!-- Global Cross-platform Fonts -->
            <FontFamily x:Key="AppFontFamily">-apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Segoe UI", Roboto, "Helvetica Neue", Inter, Arial, sans-serif</FontFamily>
            <FontFamily x:Key="AppMonoFontFamily">"SF Mono", Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace</FontFamily>
            <FontFamily x:Key="ToolTipFontFamily">-apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Inter, Arial, sans-serif</FontFamily>
            <x:Double x:Key="ToolTipFontSize">12</x:Double>
        </ResourceDictionary>
    </Application.Resources>
    
    <Application.Styles>
        <FluentTheme />

        <!-- Default language (English). Hindi/Telugu overlays are loaded at runtime -->
        <StyleInclude Source="/Resources/Strings.en.axaml"/>
        
        <!-- Import Notion theme colors -->
        <StyleInclude Source="/Styles/NotionColors.axaml"/>
        
        <!-- Import animations -->
        <StyleInclude Source="/Styles/Animations.axaml"/>
        
        <!-- Import custom controls -->
        <StyleInclude Source="/Styles/CustomControls.axaml"/>
    </Application.Styles>

</Application>
