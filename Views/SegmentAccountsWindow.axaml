<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AgentBuddy.ViewModels"
        xmlns:models="using:AgentBuddy.Models"
        mc:Ignorable="d"
        d:DesignWidth="980"
        d:DesignHeight="680"
        x:Class="AgentBuddy.Views.SegmentAccountsWindow"
        x:DataType="vm:SegmentAccountsWindowViewModel"
        Title="{DynamicResource L_Segment_Title}"
        Width="980"
        Height="680"
        MinWidth="860"
        MinHeight="560"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource AppHoverBrush}">

    <Border Padding="20" Classes="FadeIn DialogSurface">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14">
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="{DynamicResource L_Segment_Kicker}" Classes="Kicker"/>
                <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold"/>
                <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                    <Run Text="{DynamicResource L_Segment_AccountsPrefix}"/>
                    <Run Text="{Binding Count}"/>
                    <Run Text="{DynamicResource L_Segment_TotalAmountPrefix}"/>
                    <Run Text="Rs. "/>
                    <Run Text="{Binding TotalAmount, StringFormat=N0}"/>
                </TextBlock>
                <Border Background="{DynamicResource SuccessTintBrush}"
                        BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="999"
                        Padding="10,4"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding IsNewAccountsSegment}">
                    <TextBlock Text="{Binding SegmentHint}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}"/>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Classes="Card" Padding="12,10">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{DynamicResource L_Search_Watermark}"/>
            </Border>

            <Border Grid.Row="2" Classes="Card" Padding="10,8">
                <Grid ColumnDefinitions="140,*,120,120,150,60" ColumnSpacing="10">
                    <TextBlock Text="{DynamicResource L_Segment_ColumnAccountNo}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource L_Segment_ColumnAccountName}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource L_Segment_ColumnAmount}" FontWeight="SemiBold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="{DynamicResource L_Segment_ColumnPaidUpto}" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{DynamicResource L_Segment_ColumnNextDue}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="5" Text="View" FontWeight="SemiBold" TextAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="3" Classes="Card" Padding="0">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding FilteredAccounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:RDAccount">
                                <Border BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource AppBorderBrush}">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="140,*,120,120,150,60"
                                              ColumnSpacing="10">
                                            <Border Grid.ColumnSpan="5"
                                                    Padding="10,8"
                                                    Background="Transparent"
                                                    DoubleTapped="OpenProfile_DoubleTapped">
                                                <Grid ColumnDefinitions="140,*,120,120,150"
                                                      ColumnSpacing="10">
                                                    <TextBlock Text="{Binding AccountNo}" FontFamily="Consolas" FontWeight="Medium"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding AccountName}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Denomination}" TextAlignment="Right" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding MonthPaidUpto}" TextAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding NextInstallmentDate}"/>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Column="5"
                                                    Padding="10,8"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <ToggleButton x:Name="ProfileToggle"
                                                              Classes="Icon"
                                                              ToolTip.Tip="Quick view">
                                                    <Path Width="16"
                                                          Height="16"
                                                          Stretch="Uniform"
                                                          Fill="{DynamicResource AppTextSecondaryBrush}"
                                                          Data="M1.5 12C2.9 7.8 7.1 5 12 5s9.1 2.8 10.5 7c-1.4 4.2-5.6 7-10.5 7S2.9 16.2 1.5 12zm10.5 4a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/>
                                                </ToggleButton>
                                            </Border>
                                        </Grid>
                                        <Border Background="{DynamicResource AppHoverBrush}"
                                                CornerRadius="10"
                                                Margin="10,0,10,10"
                                                Padding="12"
                                                IsVisible="{Binding IsChecked, ElementName=ProfileToggle}">
                                            <Grid ColumnDefinitions="140,*,140,140"
                                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                                  RowSpacing="8"
                                                  ColumnSpacing="12">
                                                <TextBlock Text="Account"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding AccountNo}"
                                                           FontFamily="Consolas"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="Name"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding AccountName}"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="Amount"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="1"
                                                           Text="{Binding Denomination}"/>

                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="2"
                                                           Text="Paid Upto"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="3"
                                                           Text="{Binding MonthPaidUpto}"/>

                                                <TextBlock Grid.Row="2"
                                                           Text="Next Due"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="1"
                                                           Text="{Binding NextInstallmentDate}"/>

                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="2"
                                                           Text="Short Code"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="3"
                                                           Text="{Binding ShortCode}"/>

                                                <TextBlock Grid.Row="3"
                                                           Text="Opened"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                <TextBlock Grid.Row="3"
                                                           Grid.Column="1"
                                                           Text="{Binding EstimatedOpeningDateDisplay}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Classes="Secondary" Padding="16,8" Click="Close_Click" Content="{DynamicResource L_Common_Close}"/>
            </StackPanel>
        </Grid>
    </Border>

</Window>
