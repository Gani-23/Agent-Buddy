<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:AgentBuddy.Models"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
        x:Class="AgentBuddy.Views.AccountDetailsWindow"
        x:DataType="models:RDAccount"
        Title="{DynamicResource L_AccountDetails_Title}"
        Width="560"
        Height="580"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        ShowInTaskbar="False"
        CanResize="False"
        Background="{DynamicResource AppCardBackgroundBrush}"
        KeyDown="Window_KeyDown">

    <Border Padding="28" Classes="FadeIn DialogSurface">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
            
            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource L_AccountDetails_Kicker}" Classes="Kicker"/>
                    <TextBlock Text="{DynamicResource L_AccountDetails_Title}" 
                               Classes="SectionHeader"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <Separator Margin="0,8,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="Icon"
                        Click="Close_Click"
                        ToolTip.Tip="{DynamicResource L_Common_Close}">
                    <TextBlock Text="×" FontSize="16" FontWeight="Bold"/>
                </Button>
            </Grid>

            <!-- Account Information -->
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" 
                  ColumnDefinitions="150,*"
                  RowSpacing="16">
                
                <!-- Account Number -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{DynamicResource L_AccountDetails_AccountNo}" 
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding AccountNo}"
                           FontFamily="Consolas"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>

                <!-- Name -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{DynamicResource L_AccountDetails_Name}" 
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding AccountName}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>

                <!-- Amount -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{DynamicResource L_AccountDetails_Amount}" 
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding Denomination}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBlueBrush}"/>

                <!-- Due Date -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="{DynamicResource L_AccountDetails_DueDate}" 
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{Binding NextInstallmentDate}"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>

                <!-- Estimated Opening Date -->
                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="{DynamicResource L_AccountDetails_EstimatedOpeningDate}" 
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding EstimatedOpeningDateDisplay}"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource L_AccountDetails_OpeningDateNote}"
                               FontSize="11"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Month Paid Upto -->
                <TextBlock Grid.Row="5" Grid.Column="0"
                           Text="{DynamicResource L_AccountDetails_MonthPaidUpto}" 
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Grid.Row="5" Grid.Column="1"
                           Text="{Binding MonthPaidUpto}"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>

                <!-- First Seen -->
                <TextBlock Grid.Row="6" Grid.Column="0"
                           Text="{DynamicResource L_AccountDetails_FirstSeenInApp}" 
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Grid.Row="6" Grid.Column="1"
                           Text="{Binding FirstSeen, StringFormat='{}{0:dd-MMM-yyyy HH:mm}'}"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>

                <!-- Short Code -->
                <TextBlock Grid.Row="7" Grid.Column="0"
                           Text="{DynamicResource L_AccountDetails_ShortCode}" 
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Grid.Row="7" Grid.Column="1"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource AppTextPrimaryBrush}">
                    <Run Text="{Binding ShortCode}"/>
                </TextBlock>

                <!-- Last Updated -->
                <TextBlock Grid.Row="8" Grid.Column="0"
                           Text="{DynamicResource L_AccountDetails_LastUpdated}" 
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Grid.Row="8" Grid.Column="1"
                           Text="{Binding LastUpdated, StringFormat='{}{0:dd-MMM-yyyy HH:mm}'}"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>

            </Grid>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Classes="Primary" 
                        Width="120"
                        Click="AddToList_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{DynamicResource L_AccountDetails_AddToList}"/>
                    </StackPanel>
                </Button>
                
                <Button Classes="Secondary" 
                        Width="100"
                        Click="Close_Click">
                    <TextBlock Text="{DynamicResource L_Common_Close}"/>
                </Button>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </Border>

</Window>
