<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AgentBuddy.ViewModels"
        xmlns:services="using:AgentBuddy.Services"
        mc:Ignorable="d"
        d:DesignWidth="920"
        d:DesignHeight="640"
        x:Class="AgentBuddy.Views.DueRemindersWindow"
        x:DataType="vm:DueRemindersViewModel"
        Title="WhatsApp Due Date Reminders"
        Width="920"
        Height="650"
        MinWidth="800"
        MinHeight="550"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource AppCardBackgroundBrush}">

    <Border Padding="24" Classes="FadeIn DialogSurface">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="CUSTOMER OUTREACH &amp; DEPOSITS" Classes="Kicker" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="WhatsApp Due Date Reminders" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Click="CloseButton_Click" Background="Transparent" Foreground="{DynamicResource AppTextSecondaryBrush}" Padding="8" Content="✕" FontSize="16"/>
            </Grid>

            <!-- Search, Stats & Filter Bar -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery, Mode=TwoWay}"
                         PlaceholderText="🔍 Search account holder name, account number, or month..."
                         Classes="SearchTextBox"
                         CornerRadius="10"
                         Padding="12,10"/>

                <!-- Total Count & Amount Badge -->
                <Border Grid.Column="1" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="10" Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding TotalDueCount, StringFormat='{}{0} Due'}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="•" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalDueAmount, StringFormat='₹ {0:N0}'}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Refresh Button -->
                <Button Grid.Column="2" Command="{Binding RefreshCommand}" Content="🔄 Refresh" CornerRadius="10" Padding="14,10"/>
            </Grid>

            <!-- Reminders List -->
            <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="12" Padding="8">
                <ListBox ItemsSource="{Binding Items}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="services:DueReminderItem">
                            <Border Padding="12,10"
                                    Margin="0,2"
                                    CornerRadius="8"
                                    Background="{DynamicResource AppCardBackgroundBrush}">
                                <Grid ColumnDefinitions="*,140,Auto,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                    <!-- Customer Details -->
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding AccountName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding AccountNo, StringFormat='A/C: {0}'}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" FontFamily="Consolas, monospace"/>
                                            <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding MonthPaidUpto, StringFormat='Paid: {0}'}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Due Amount -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock Text="{Binding Amount, StringFormat='₹ {0:N0}'}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Installment Due" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <!-- Copy Message Button -->
                                    <Button Grid.Column="2"
                                            Click="CopySingleMessage_Click"
                                            Tag="{Binding ReminderMessage}"
                                            Content="📋 Copy"
                                            Padding="10,6"
                                            CornerRadius="6"
                                            FontSize="12"/>

                                    <!-- Send WhatsApp Button -->
                                    <Button Grid.Column="3"
                                            Click="OpenWhatsApp_Click"
                                            Tag="{Binding WhatsAppUrl}"
                                            Classes="PrimaryButton"
                                            Content="💬 WhatsApp"
                                            Padding="12,6"
                                            CornerRadius="6"
                                            FontSize="12"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Footer Bar -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Button Grid.Column="0" Click="CopyAllSummary_Click" Content="📋 Copy All Reminders Summary" Padding="14,10" CornerRadius="8"/>
                <TextBlock x:Name="FooterStatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                <Button Grid.Column="2" Click="CloseButton_Click" Content="Done" Padding="16,10" CornerRadius="8"/>
            </Grid>
        </Grid>
    </Border>
</Window>
