<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AgentBuddy.ViewModels"
        xmlns:services="using:AgentBuddy.Services"
        mc:Ignorable="d"
        d:DesignWidth="920"
        d:DesignHeight="640"
        x:Class="AgentBuddy.Views.DueRemindersWindow"
        x:DataType="vm:DueRemindersViewModel"
        Title="WhatsApp Due Date Reminders"
        Width="940"
        Height="660"
        MinWidth="800"
        MinHeight="550"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource AppBackgroundBrush}">

    <Border Classes="DialogBackdrop" Padding="16">
        <Border Classes="DialogSurface" Padding="22">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Classes="DialogDot" Background="#25D366"/>
                            <TextBlock Text="CUSTOMER OUTREACH &amp; DEPOSITS" Classes="Kicker" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="WhatsApp Due Date Reminders" Classes="DialogTitle" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="CloseButton_Click" Classes="Icon" Width="32" Height="32" ToolTip.Tip="Close">
                        <PathIcon Data="{StaticResource Icon_Close}" Width="14" Height="14" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </Button>
                </Grid>

                <!-- Search, Stats & Filter Bar -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             PlaceholderText="🔍 Search account holder name, account number, or month..."
                             Classes="SearchTextBox"
                             CornerRadius="10"
                             Padding="12,10"/>

                    <!-- Total Count & Amount Badge -->
                    <Border Grid.Column="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalDueCount, StringFormat='{}{0} Due'}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="•" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalDueAmount, StringFormat='₹ {0:N0}'}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Refresh Button -->
                    <Button Grid.Column="2" Command="{Binding RefreshCommand}" Classes="Secondary" Content="🔄 Refresh" CornerRadius="10" Padding="14,10"/>
                </Grid>

                <!-- Reminders List -->
                <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
                    <ListBox ItemsSource="{Binding Items}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="services:DueReminderItem">
                                <Border Padding="14,10"
                                        Margin="0,3"
                                        CornerRadius="10"
                                        Background="{DynamicResource AppCardBackgroundBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="*,140,Auto,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                        <!-- Customer Details -->
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="{Binding AccountName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AccountNo, StringFormat='A/C: {0}'}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" FontFamily="{StaticResource AppMonoFontFamily}"/>
                                                <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding MonthPaidUpto, StringFormat='Paid: {0}'}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding NextDueDate, StringFormat='Next: {0}'}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Due Amount -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                            <TextBlock Text="{Binding Amount, StringFormat='₹ {0:N0}'}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="Installment Due" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <!-- Copy Message Button -->
                                        <Button Grid.Column="2"
                                                Classes="Secondary"
                                                Click="CopySingleMessage_Click"
                                                Tag="{Binding ReminderMessage}"
                                                Content="📋 Copy"
                                                Padding="10,6"
                                                CornerRadius="6"
                                                FontSize="12"/>

                                        <!-- Send WhatsApp Button -->
                                        <Button Grid.Column="3"
                                                Classes="Primary"
                                                Click="OpenWhatsApp_Click"
                                                Tag="{Binding WhatsAppUrl}"
                                                Content="💬 WhatsApp"
                                                Padding="12,6"
                                                CornerRadius="6"
                                                FontSize="12"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Footer Bar -->
                <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                    <Button Grid.Column="0" Classes="Secondary" Click="CopyAllSummary_Click" Content="📋 Copy All Reminders Summary" Padding="14,9" CornerRadius="8"/>
                    <TextBlock x:Name="FooterStatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                    <Button Grid.Column="2" Classes="Primary" Click="CloseButton_Click" Content="Done" Padding="18,9" CornerRadius="8"/>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
