<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:AgentBuddy.Models"
             xmlns:vm="using:AgentBuddy.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="AgentBuddy.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="0,0,0,24">
            <StackPanel Spacing="2">
                <TextBlock Text="{DynamicResource L_Report_Kicker}" Classes="Kicker"/>
                <TextBlock Text="{DynamicResource L_Report_Title}" Classes="SectionHeader"/>
            </StackPanel>

            <Border Classes="Card" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource L_Report_DailySummary}" Classes="SubHeader"/>
                    <TextBlock Text="{Binding SummaryText}"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Report Actions Toolbar -->
            <WrapPanel>
                <Button Classes="Primary"
                        Command="{Binding RefreshCommand}"
                        Padding="14,9"
                        Margin="0,0,10,8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                        <PathIcon Grid.Column="0" Data="{StaticResource Icon_Sync}" Width="14" Height="14" Foreground="White"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource L_Common_Refresh}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Button Classes="Success"
                        Command="{Binding PrintAllCommand}"
                        IsEnabled="{Binding HasPrintableReports}"
                        Padding="14,9"
                        Margin="0,0,10,8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                        <PathIcon Grid.Column="0" Data="{StaticResource Icon_Print}" Width="14" Height="14" Foreground="White"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource L_Report_PrintAllToday}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Button Classes="Secondary"
                        Command="{Binding GeneratePayslipsCommand}"
                        IsEnabled="{Binding HasReports}"
                        Padding="14,9"
                        Margin="0,0,6,8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                        <PathIcon Grid.Column="0" Data="{StaticResource Icon_Reports}" Width="14" Height="14" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource L_Report_GeneratePayslip}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Button Classes="Secondary"
                        Command="{Binding TogglePayslipOptionsCommand}"
                        Padding="10,9"
                        Margin="0,0,10,8"
                        ToolTip.Tip="Configure payslip format, counterfoils, and charge visibility">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
                        <PathIcon Grid.Column="0" Data="{StaticResource Icon_Settings}" Width="13" Height="13" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="Options ▾" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                </Button>

                <Button Classes="Secondary"
                        Command="{Binding GenerateMissingReportsCommand}"
                        IsEnabled="{Binding HasMissingReports}"
                        Padding="14,9"
                        Margin="0,0,10,8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                        <PathIcon Grid.Column="0" Data="{StaticResource Icon_Plus}" Width="14" Height="14" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource L_Report_GenerateMissingPdfs}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </WrapPanel>

            <!-- Printer Configuration Toolbar -->
            <Border Classes="Card"
                    Padding="12,8"
                    Margin="0,0,0,2">
                <WrapPanel VerticalAlignment="Center">
                    <!-- Default Printer Selection -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,4">
                        <PathIcon Data="{StaticResource Icon_Print}" Width="13" Height="13" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource L_Report_DefaultPrinter}"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <ComboBox Width="200"
                                  Height="32"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding PrinterOptions}"
                                  SelectedItem="{Binding SelectedPrinter}"
                                  IsEnabled="{Binding HasPrinterOptions}"/>
                        <Button Classes="Secondary"
                                Command="{Binding SetDefaultPrinterCommand}"
                                IsEnabled="{Binding HasPrinterOptions}"
                                Height="32"
                                Padding="10,0"
                                ToolTip.Tip="Save as Default Printer">
                            <TextBlock Text="{DynamicResource L_Report_SetDefaultPrinter}" FontSize="11" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="Icon"
                                Command="{Binding RefreshPrintersCommand}"
                                Width="32"
                                Height="32"
                                ToolTip.Tip="Refresh Available Printers">
                            <PathIcon Data="{StaticResource Icon_Sync}" Width="13" Height="13" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- Print Copies -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="{DynamicResource L_Report_PrintCopies}"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <ComboBox Width="72"
                                  Height="32"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding CopyOptions}"
                                  SelectedItem="{Binding PrintCopies}"/>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- Configurable Payslip Print Options Panel -->
            <Border Classes="Card"
                    Padding="14,10"
                    Margin="0,0,0,4"
                    IsVisible="{Binding IsPayslipOptionsOpen}">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,6" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource Icon_FileText}" Width="13" Height="13" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <TextBlock Text="Payslip Layout:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox Width="230"
                                  Height="32"
                                  ItemsSource="{Binding PayslipLayoutOptions}"
                                  SelectedItem="{Binding SelectedPayslipLayout}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PayslipLayoutOption">
                                    <TextBlock Text="{Binding Title}" FontSize="12"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding SelectedPayslipLayout.Subtitle}"
                                   FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,6" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding ShowPayslipDefaultFee}" VerticalAlignment="Center">
                            <TextBlock Text="Show Default Charges" FontSize="11.5"/>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding ShowPayslipRebate}" VerticalAlignment="Center">
                            <TextBlock Text="Show Rebates" FontSize="11.5"/>
                        </CheckBox>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <Border Classes="Card" Padding="16" IsVisible="{Binding HasReports}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{DynamicResource L_Report_TodayLists}" Classes="SubHeader"/>

                    <ItemsControl ItemsSource="{Binding TodayReports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DailyListReport">
                                <Border Margin="0,4"
                                        Padding="12"
                                        Background="{DynamicResource AppSidebarBackgroundBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <CheckBox IsChecked="{Binding IsSelectedForPayslip}"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ReferenceNumber}"
                                                       FontFamily="{StaticResource AppMonoFontFamily}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding ListDisplay}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding TimestampDisplay}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Classes="Secondary"
                                                    Content="{DynamicResource L_Report_View}"
                                                    Click="ViewPdf_Click"
                                                    IsEnabled="{Binding HasPdf}"
                                                    Padding="12,6"/>
                                            <Button Classes="Primary"
                                                    Content="{DynamicResource L_Report_Print}"
                                                    Click="PrintPdf_Click"
                                                    IsEnabled="{Binding HasPdf}"
                                                    Padding="12,6"/>
                                            <Button Classes="Danger"
                                                    Content="{DynamicResource L_Report_Delete}"
                                                    Click="DeleteReport_Click"
                                                    Padding="12,6"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}">
                                            <Run Text="{DynamicResource L_Report_AccountsLabel}"/>
                                            <Run Text="{Binding AccountCount}"/>
                                        </TextBlock>

                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}">
                                            <Run Text="{DynamicResource L_Report_PdfAvailableLabel}"/>
                                            <Run Text="{Binding HasPdf}"/>
                                        </TextBlock>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding AccountsRaw}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   FontSize="11"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="Card" Padding="16" IsVisible="{Binding !HasReports}">
                <TextBlock Text="{DynamicResource L_Report_NoListsToday}"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
