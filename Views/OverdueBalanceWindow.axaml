<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AgentBuddy.ViewModels"
        xmlns:models="using:AgentBuddy.Models"
        mc:Ignorable="d"
        d:DesignWidth="940"
        d:DesignHeight="640"
        x:Class="AgentBuddy.Views.OverdueBalanceWindow"
        x:DataType="vm:OverdueBalanceWindowViewModel"
        Title="{DynamicResource L_Balance_WindowTitle}"
        Width="980"
        Height="660"
        MinWidth="860"
        MinHeight="560"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource AppCardBackgroundBrush}">

    <Border Padding="18"
            Classes="FadeIn"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
            <Grid Grid.Row="0">
                <StackPanel Spacing="2">
                    <TextBlock Text="{DynamicResource L_Balance_Kicker}" Classes="Kicker"/>
                    <TextBlock Text="{DynamicResource L_Balance_Title}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="32"/>
                    <TextBlock Text="{Binding SummaryText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <Border Classes="Card" Padding="12,9">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding StarterSummaryTitle}" Classes="Kicker"/>
                        <TextBlock Text="{Binding StarterSummaryText}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="Card" Padding="14,9" MinWidth="112">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{DynamicResource L_Balance_ShownLabel}" Classes="Kicker"/>
                        <TextBlock Text="{Binding CountDisplay}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Classes="Card" Padding="14,9" MinWidth="180">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{DynamicResource L_Balance_TotalLabel}" Classes="Kicker"/>
                        <TextBlock Text="{Binding TotalBalanceDisplay}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Classes="Card" Padding="12">
                <Grid ColumnDefinitions="*,170,190,Auto" ColumnSpacing="10">
                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{DynamicResource L_Balance_SearchWatermark}"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding MonthFilterOptions}"
                              SelectedItem="{Binding SelectedMonthFilter}"
                              VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption}"
                              VerticalAlignment="Center"/>

                    <Button Grid.Column="3"
                            Classes="Secondary"
                            Command="{Binding RefreshCommand}"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon_Refresh}" Width="14" Height="14"/>
                            <TextBlock Text="{DynamicResource L_Common_Refresh}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="3" Classes="Card" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Background="{DynamicResource AppSidebarBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <Grid ColumnDefinitions="125,*,85,75,95,75,95,100"
                              ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="{DynamicResource L_Balance_ColumnAccount}" Classes="Kicker"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource L_Balance_ColumnName}" Classes="Kicker"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource L_Balance_ColumnDenom}" Classes="Kicker" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource L_Balance_ColumnOverdue}" Classes="Kicker" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{DynamicResource L_Balance_ColumnTotalDue}" Classes="Kicker" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="{DynamicResource L_Balance_ColumnPaidUpto}" Classes="Kicker"/>
                            <TextBlock Grid.Column="6" Text="{DynamicResource L_Balance_ColumnNextDue}" Classes="Kicker"/>
                            <TextBlock Grid.Column="7" Text="{DynamicResource L_Balance_ColumnActions}" Classes="Kicker" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredAccounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:OverdueBalanceAccount">
                                    <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,9">
                                        <Grid ColumnDefinitions="125,*,85,75,95,75,95,100"
                                              ColumnSpacing="8"
                                              VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding AccountNo}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding AccountName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AmountDisplay}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="3"
                                                    Background="{DynamicResource WarningTintBrush}"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding DurationTooltip}">
                                                <TextBlock Text="{Binding DurationShortDisplay}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource WarningBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding BalanceAmountDisplay}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding MonthPaidUpto}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding NextInstallmentDate}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="7"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Button Classes="Secondary"
                                                        Padding="6"
                                                        Width="28"
                                                        Height="28"
                                                        ToolTip.Tip="{DynamicResource L_Balance_Copy}"
                                                        Click="Copy_Click">
                                                    <PathIcon Data="{StaticResource Icon_Copy}" Width="12" Height="12"/>
                                                </Button>
                                                <Button Classes="Primary"
                                                        Padding="6"
                                                        Width="28"
                                                        Height="28"
                                                        ToolTip.Tip="{DynamicResource L_Balance_Add}"
                                                        Click="Add_Click">
                                                    <PathIcon Data="{StaticResource Icon_Plus}" Width="12" Height="12"/>
                                                </Button>
                                                <Button Classes="Secondary"
                                                        Padding="6"
                                                        Width="28"
                                                        Height="28"
                                                        ToolTip.Tip="{DynamicResource L_Balance_View}"
                                                        Click="View_Click">
                                                    <PathIcon Data="{StaticResource Icon_Folder}" Width="12" Height="12"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="Secondary" Padding="16,8" Click="Close_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Icon_Close}" Width="14" Height="14"/>
                        <TextBlock Text="{DynamicResource L_Common_Close}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
