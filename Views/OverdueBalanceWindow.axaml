<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AgentBuddy.ViewModels"
        xmlns:models="using:AgentBuddy.Models"
        mc:Ignorable="d"
        d:DesignWidth="940"
        d:DesignHeight="640"
        x:Class="AgentBuddy.Views.OverdueBalanceWindow"
        x:DataType="vm:OverdueBalanceWindowViewModel"
        Title="{DynamicResource L_Balance_WindowTitle}"
        Width="940"
        Height="640"
        MinWidth="820"
        MinHeight="560"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource AppHoverBrush}">

    <Border Padding="18" Classes="FadeIn DialogSurface">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
            <Grid Grid.Row="0">
                <StackPanel Spacing="2">
                    <TextBlock Text="{DynamicResource L_Balance_Kicker}" Classes="Kicker"/>
                    <TextBlock Text="{DynamicResource L_Balance_Title}"
                               FontSize="24"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               LineHeight="32"/>
                    <TextBlock Text="{Binding SummaryText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <Border Classes="Card" Padding="12,9">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding StarterSummaryTitle}" Classes="Kicker"/>
                        <TextBlock Text="{Binding StarterSummaryText}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="Card" Padding="14,9" MinWidth="112">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{DynamicResource L_Balance_ShownLabel}" Classes="Kicker"/>
                        <TextBlock Text="{Binding CountDisplay}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Classes="Card" Padding="14,9" MinWidth="180">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{DynamicResource L_Balance_TotalLabel}" Classes="Kicker"/>
                        <TextBlock Text="{Binding TotalBalanceDisplay}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Classes="Card" Padding="12">
                <Grid ColumnDefinitions="*,150,190,Auto" ColumnSpacing="10">
                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{DynamicResource L_Balance_SearchWatermark}"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding MonthFilterOptions}"
                              SelectedItem="{Binding SelectedMonthFilter}"
                              VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption}"
                              VerticalAlignment="Center"/>

                    <Button Grid.Column="3"
                            Classes="Secondary"
                            Command="{Binding RefreshCommand}"
                            Padding="14,8"
                            Content="{DynamicResource L_Common_Refresh}"/>
                </Grid>
            </Border>

            <Border Grid.Row="3" Classes="Card" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Background="{DynamicResource AppSidebarBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <Grid ColumnDefinitions="135,*,105,95,120,175"
                              ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="{DynamicResource L_Balance_ColumnAccount}" Classes="Kicker"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource L_Balance_ColumnName}" Classes="Kicker"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource L_Balance_ColumnBalance}" Classes="Kicker"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource L_Balance_ColumnPaidUpto}" Classes="Kicker"/>
                            <TextBlock Grid.Column="4" Text="{DynamicResource L_Balance_ColumnNextDue}" Classes="Kicker"/>
                            <TextBlock Grid.Column="5" Text="{DynamicResource L_Balance_ColumnActions}" Classes="Kicker"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredAccounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:OverdueBalanceAccount">
                                    <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,9">
                                        <Grid ColumnDefinitions="135,*,105,95,120,175"
                                              ColumnSpacing="10"
                                              VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding AccountNo}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding AccountName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource AppWarningSoftBrush}"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppWarningBrush}">
                                                    <Run Text="{Binding BalanceMonths}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{DynamicResource L_Balance_MonthsSuffix}"/>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding MonthPaidUpto}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding NextInstallmentDate}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="5"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <Button Classes="Secondary"
                                                        Padding="8,5"
                                                        Click="Copy_Click"
                                                        Content="{DynamicResource L_Balance_Copy}"/>
                                                <Button Classes="Primary"
                                                        Padding="8,5"
                                                        Click="Add_Click"
                                                        Content="{DynamicResource L_Balance_Add}"/>
                                                <Button Classes="Secondary"
                                                        Padding="8,5"
                                                        Click="View_Click"
                                                        Content="{DynamicResource L_Balance_View}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="Secondary" Padding="16,8" Click="Close_Click" Content="{DynamicResource L_Common_Close}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
