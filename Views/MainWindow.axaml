<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentBuddy.ViewModels"
        xmlns:views="using:AgentBuddy.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="AgentBuddy.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{DynamicResource L_App_WindowTitle}"
        Icon="/Assets/AgentBuddy.ico"
        Width="1400"
        Height="900"
        MinWidth="1200"
        MinHeight="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="250,*" Background="{DynamicResource AppBackgroundBrush}">

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{DynamicResource AppSidebarBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20">

            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
                <!-- App Brand Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" 
                            Background="{StaticResource AccentBlueBrush}" 
                            VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource Icon_Logo}" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L_Main_AppName}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   LetterSpacing="-0.3"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource L_Main_Subtitle}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="Medium"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{DynamicResource L_Main_Navigation}"
                           Classes="Kicker"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           FontSize="10"
                           FontWeight="Bold"
                           LetterSpacing="1.2"
                           Margin="4,6,4,0"/>

                <!-- Navigation List -->
                <StackPanel Grid.Row="2" Spacing="4">
                    <Button x:Name="DashboardNavButton"
                            Classes="NavItem"
                            IsEnabled="{Binding IsLicenseActive}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Dashboard">
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <PathIcon Grid.Column="0" Data="{StaticResource Icon_Dashboard}" Width="15" Height="15" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource L_Nav_Dashboard}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="ListsNavButton"
                            Classes="NavItem"
                            IsEnabled="{Binding IsLicenseActive}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Lists">
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <PathIcon Grid.Column="0" Data="{StaticResource Icon_Lists}" Width="15" Height="15" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource L_Nav_CreateLists}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="FixedDepositsNavButton"
                            Classes="NavItem"
                            IsEnabled="{Binding IsLicenseActive}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="FixedDeposits">
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <PathIcon Grid.Column="0" Data="{StaticResource Icon_Clock}" Width="15" Height="15" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource L_Nav_FixedDeposits}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="ReportsNavButton"
                            Classes="NavItem"
                            IsEnabled="{Binding IsLicenseActive}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Reports">
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <PathIcon Grid.Column="0" Data="{StaticResource Icon_Reports}" Width="15" Height="15" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource L_Nav_Reports}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="SupportNavButton"
                            Classes="NavItem"
                            IsEnabled="{Binding IsLicenseActive}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Support">
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <PathIcon Grid.Column="0" Data="{StaticResource Icon_Support}" Width="15" Height="15" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource L_Nav_Support}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="SettingsNavButton"
                            Classes="NavItem"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings">
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <PathIcon Grid.Column="0" Data="{StaticResource Icon_Settings}" Width="15" Height="15" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource L_Nav_Settings}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Footer: License & Theme Panel -->
                <StackPanel Grid.Row="3" Spacing="8">
                    <!-- License Badge -->
                    <Border Background="{DynamicResource InfoTintBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                            <PathIcon Grid.Column="0" Data="{StaticResource Icon_Shield}" Width="13" Height="13" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LicenseStatusText}"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Theme Switcher Button -->
                    <Button Classes="NavItem"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="{DynamicResource L_Main_ToggleTheme}"
                            Background="{DynamicResource AppCardBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="8" VerticalAlignment="Center">
                            <PathIcon Grid.Column="0" Data="{StaticResource Icon_Theme_Palette}" Width="14" Height="14" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource L_Main_ToggleTheme}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Border Grid.Column="1" Padding="20">
            <ContentControl Content="{Binding CurrentView}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:DashboardViewModel">
                        <views:DashboardView/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:ListManagementViewModel">
                        <views:ListManagementView/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:FixedDepositViewModel">
                        <views:FixedDepositView/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:ReportsViewModel">
                        <views:ReportsView/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:SupportViewModel">
                        <views:SupportView/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:SettingsViewModel">
                        <views:SettingsView/>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>

        <!-- FLOATING OVERDUE BALANCE BUTTON -->
        <Border Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,24"
                CornerRadius="20"
                BoxShadow="0 4 14 0 #332563EB, 0 2 6 0 #0000001A">
            <Button Classes="Primary"
                    Height="40"
                    Padding="16,0"
                    CornerRadius="20"
                    IsEnabled="{Binding IsLicenseActive}"
                    Click="OpenBalanceBuddy_Click"
                    ToolTip.Tip="Open overdue balance accounts">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_Bolt}" Width="15" Height="15" Foreground="White"/>
                    <TextBlock Grid.Column="1" Text="Balance" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </Border>

    </Grid>

</Window>
