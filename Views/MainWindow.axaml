<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentBuddy.ViewModels"
        xmlns:views="using:AgentBuddy.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="AgentBuddy.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{DynamicResource L_App_WindowTitle}"
        Icon="/Assets/AgentBuddy.ico"
        Width="1400"
        Height="900"
        MinWidth="1200"
        MinHeight="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="240,*" Background="{DynamicResource AppBackgroundBrush}">

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{DynamicResource AppSidebarBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">

            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
                <!-- App Brand Card -->
                <Border Grid.Row="0" Classes="Card" Padding="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" 
                                Background="{StaticResource AccentBlueBrush}" 
                                VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource Icon_Sparkle}" Width="18" Height="18" Foreground="White"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource L_Main_AppName}"
                                       FontSize="20"
                                       FontWeight="Black"
                                       LetterSpacing="-0.5"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource L_Main_Subtitle}"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="{DynamicResource L_Main_Navigation}"
                           Classes="Kicker"
                           LetterSpacing="1.5"
                           Margin="8,4,8,0"/>

                <!-- Navigation List -->
                <StackPanel Grid.Row="2" Spacing="8">
                    <Button x:Name="DashboardNavButton"
                            Classes="NavItem"
                            IsEnabled="{Binding IsLicenseActive}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Dashboard">
                        <Grid ColumnDefinitions="24,*" ColumnSpacing="12" VerticalAlignment="Center">
                            <PathIcon Grid.Column="0" Data="{StaticResource Icon_Dashboard}" Width="16" Height="16" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource L_Nav_Dashboard}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="ListsNavButton"
                            Classes="NavItem"
                            IsEnabled="{Binding IsLicenseActive}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Lists">
                        <Grid ColumnDefinitions="24,*" ColumnSpacing="12" VerticalAlignment="Center">
                            <PathIcon Grid.Column="0" Data="{StaticResource Icon_Lists}" Width="16" Height="16" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource L_Nav_CreateLists}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="ReportsNavButton"
                            Classes="NavItem"
                            IsEnabled="{Binding IsLicenseActive}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Reports">
                        <Grid ColumnDefinitions="24,*" ColumnSpacing="12" VerticalAlignment="Center">
                            <PathIcon Grid.Column="0" Data="{StaticResource Icon_Reports}" Width="16" Height="16" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource L_Nav_Reports}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="SupportNavButton"
                            Classes="NavItem"
                            IsEnabled="{Binding IsLicenseActive}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Support">
                        <Grid ColumnDefinitions="24,*" ColumnSpacing="12" VerticalAlignment="Center">
                            <PathIcon Grid.Column="0" Data="{StaticResource Icon_Support}" Width="16" Height="16" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource L_Nav_Support}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="SettingsNavButton"
                            Classes="NavItem"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings">
                        <Grid ColumnDefinitions="24,*" ColumnSpacing="12" VerticalAlignment="Center">
                            <PathIcon Grid.Column="0" Data="{StaticResource Icon_Settings}" Width="16" Height="16" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource L_Nav_Settings}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Footer / Theme & License -->
                <StackPanel Grid.Row="3" Spacing="10">
                    <Border Classes="Card" Padding="10">
                        <Border Classes="LicenseBadge" Padding="10"
                                Background="{DynamicResource InfoTintBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <PathIcon Grid.Column="0" Data="{StaticResource Icon_Shield}" Width="14" Height="14" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding LicenseStatusText}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </Border>

                    <Border Classes="Card" Padding="6">
                        <Button Classes="NavItem" Command="{Binding ToggleThemeCommand}">
                            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <PathIcon Grid.Column="0" Data="{StaticResource Icon_Theme_Palette}" Width="16" Height="16" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{DynamicResource L_Main_ToggleTheme}" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ThemeModeLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Border Grid.Column="1" Padding="20">
            <Border Classes="SectionCard" Padding="22">
                <ContentControl Content="{Binding CurrentView}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="vm:DashboardViewModel">
                            <views:DashboardView/>
                        </DataTemplate>
                        <DataTemplate DataType="vm:ListManagementViewModel">
                            <views:ListManagementView/>
                        </DataTemplate>
                        <DataTemplate DataType="vm:ReportsViewModel">
                            <views:ReportsView/>
                        </DataTemplate>
                        <DataTemplate DataType="vm:SupportViewModel">
                            <views:SupportView/>
                        </DataTemplate>
                        <DataTemplate DataType="vm:SettingsViewModel">
                            <views:SettingsView/>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </Border>
        </Border>

        <Button Grid.Column="1"
                Classes="Primary"
                Height="42"
                Padding="16,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,36,34"
                IsEnabled="{Binding IsLicenseActive}"
                Click="OpenBalanceBuddy_Click"
                ToolTip.Tip="Open overdue balance accounts">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                <PathIcon Grid.Column="0" Data="{StaticResource Icon_Bolt}" Width="16" Height="16" Foreground="White"/>
                <TextBlock Grid.Column="1" Text="Balance" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </Button>

    </Grid>

</Window>
