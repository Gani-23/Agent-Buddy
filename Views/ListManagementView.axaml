<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:AgentBuddy.Models"
             xmlns:vm="using:AgentBuddy.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="AgentBuddy.Views.ListManagementView"
             x:Name="RootView"
             x:DataType="vm:ListManagementViewModel">
    <UserControl.Styles>
        <Style Selector="TextBox[Tag=InstallmentSuggested]">
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuggestionBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button[Tag=RowDelete]">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button[Tag=RowDelete]:pointerover">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border[Tag=Ready]">
            <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border[Tag=Review]">
            <Setter Property="Background" Value="{DynamicResource WarningTintBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border[Tag=Blocked]">
            <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border[Tag=Idle]">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="8"
          Margin="0,0,0,6">

        <!-- Top Header: Title Only -->
        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L_List_Title}"
                   Classes="SectionHeader"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0"
                   VerticalAlignment="Center"/>

        <!-- Row 1: Action Toolbar (Left) & Database Guard Card (Right) Side-by-Side -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,380"
              ColumnSpacing="10">

            <!-- Action Toolbar Card -->
            <Border Grid.Column="0"
                    Classes="Card"
                    Padding="12,8">
                <Grid RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="7"
                      VerticalAlignment="Center">

                    <!-- Line 1 Inside Card: Status Chips & Summary Info -->
                    <WrapPanel Grid.Row="0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left">
                        <Border Classes="StatusChip" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Lists:" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Lists.Count}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="StatusChip" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="References:" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ReferenceNumbers.Count}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="StatusChip" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AutoSaveStatusText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="StatusChip" Margin="0,0,6,0">
                            <TextBlock Text="{Binding SavedLotStatusText}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border Classes="StatusChip"
                                Background="{DynamicResource ListDuplicateTintBrush}"
                                BorderBrush="{DynamicResource ListDuplicateBorderBrush}"
                                Margin="0,0,6,0"
                                IsVisible="{Binding HasFailedLists}">
                            <TextBlock Text="Failed lists need attention"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ErrorBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </WrapPanel>

                    <!-- Line 2 Inside Card: Action Buttons (Workflow on Left, Delete on Right) -->
                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="8"
                          VerticalAlignment="Center">
                        <WrapPanel Grid.Column="0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left">
                            <Button Classes="Primary" 
                                    Command="{Binding AddNewListCommand}"
                                    IsEnabled="{Binding CanEditLists}"
                                    MinHeight="30"
                                    Padding="10,4"
                                    Margin="0,0,6,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_Plus}" Width="12" Height="12" Foreground="White"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource L_List_AddList}" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button Classes="Success" 
                                    Command="{Binding ProcessAllListsCommand}"
                                    MinHeight="30"
                                    Padding="10,4"
                                    Margin="0,0,6,0"
                                    IsEnabled="{Binding CanProcessLists}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_Bolt}" Width="12" Height="12" Foreground="White"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource L_List_StartWalk}" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button Classes="Secondary" 
                                    Command="{Binding RetryFailedListsCommand}"
                                    IsEnabled="{Binding CanRetryFailedLists}"
                                    MinHeight="30"
                                    Padding="10,4"
                                    Margin="0,0,6,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_Sync}" Width="12" Height="12" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource L_List_RetryFailed}" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button Classes="Secondary" 
                                    Command="{Binding ValidateAllAccountsCommand}"
                                    IsEnabled="{Binding CanValidateLists}"
                                    MinHeight="30"
                                    Padding="10,4"
                                    Margin="0,0,6,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_Check}" Width="12" Height="12" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource L_List_ValidateAccounts}" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button Classes="Secondary" 
                                    Command="{Binding SaveLotCommand}"
                                    MinHeight="30"
                                    Padding="10,4"
                                    Margin="0,0,6,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_Copy}" Width="12" Height="12" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource L_List_SaveLot}" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button Classes="Secondary" 
                                    Command="{Binding ReloadLotCommand}"
                                    MinHeight="30"
                                    Padding="10,4"
                                    Margin="0,0,6,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_Sync}" Width="12" Height="12" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource L_List_ReloadList}" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                                </Grid>
                            </Button>
                        </WrapPanel>

                        <!-- Danger Action: Delete All (Right-aligned) -->
                        <Button Grid.Column="1"
                                Classes="Danger" 
                                Command="{Binding DeleteAllListsCommand}"
                                MinHeight="30"
                                Padding="10,4"
                                VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
                                <PathIcon Grid.Column="0" Data="{StaticResource Icon_Trash}" Width="12" Height="12" Foreground="White"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource L_List_DeleteAll}" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Warning if failed -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource WarningTintBrush}"
                            BorderBrush="{StaticResource WarningBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,5"
                            IsVisible="{Binding ShowRetryFailedWarning}">
                        <TextBlock Text="Some lists failed. Use Retry Failed Only to avoid report conflicts."
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource WarningBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Database Guard Card -->
            <Border Grid.Column="1"
                    Classes="Card"
                    Padding="12,8"
                    HorizontalAlignment="Stretch">
                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="7"
                      VerticalAlignment="Center">
                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock Text="{Binding DatabaseStatusTitle}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <TextBlock Text="{Binding DatabaseStatusMessage}"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <TextBlock Text="Override active. Review accounts carefully."
                                   IsVisible="{Binding ShowOverrideWarning}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}"/>
                    </StackPanel>

                    <!-- 3 Buttons on the same single line -->
                    <UniformGrid Grid.Row="1" Rows="1" ColumnSpacing="6">
                        <Button Classes="Primary"
                                Command="{Binding UpdateDatabaseCommand}"
                                IsEnabled="{Binding !IsUpdatingDatabase}"
                                MinHeight="28"
                                Padding="6,3">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" VerticalAlignment="Center">
                                <PathIcon Grid.Column="0" Data="{StaticResource Icon_Database}" Width="11" Height="11" Foreground="White"/>
                                <TextBlock Grid.Column="1" Text="Update DB" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                            </Grid>
                        </Button>

                        <Button Classes="Secondary"
                                Command="{Binding RefreshDatabaseStatusCommand}"
                                IsEnabled="{Binding !IsUpdatingDatabase}"
                                MinHeight="28"
                                Padding="6,3">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" VerticalAlignment="Center">
                                <PathIcon Grid.Column="0" Data="{StaticResource Icon_Refresh}" Width="11" Height="11" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="Recheck" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                            </Grid>
                        </Button>

                        <Button Classes="Danger"
                                Command="{Binding OverrideDatabaseGuardCommand}"
                                IsEnabled="{Binding !IsUpdatingDatabase}"
                                MinHeight="28"
                                Padding="6,3"
                                IsVisible="{Binding ShowOverrideButton}">
                            <TextBlock Text="Proceed" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" Margin="0,0,0,24">

            <!-- Processing Status -->
            <Border Classes="Card"
                    Padding="16"
                    Background="{DynamicResource InfoTintBrush}"
                    IsVisible="{Binding IsProcessing}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⏳" Classes="Pulse" FontSize="16"/>
                        <TextBlock Text="{DynamicResource L_List_Processing}" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ProcessStatus}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Classes="Card"
                    Padding="16"
                    IsVisible="{Binding HasProcessingLogs}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Runtime Logs"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <Border Background="{DynamicResource AppHoverBrush}"
                            CornerRadius="6"
                            Padding="10"
                            ClipToBounds="True">
                        <ScrollViewer MaxHeight="170"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ProcessingLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="{StaticResource AppMonoFontFamily}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Reference Numbers Display -->
            <Border Classes="Card"
                    Padding="20"
                    IsVisible="{Binding ReferenceNumbers.Count}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource L_List_ReferenceNumbers}"
                               Classes="SubHeader"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    
                    <ItemsControl ItemsSource="{Binding ReferenceNumbers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,6"
                                        Margin="0,0,8,8"
                                        Background="{DynamicResource SuccessTintBrush}"
                                        BorderBrush="{StaticResource AccentGreenBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <TextBlock Text="{Binding}"
                                               FontFamily="{StaticResource AppMonoFontFamily}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Lists Container -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Lists}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ListPanelViewModel">
                            <Border Classes="Card Hoverable" 
                                    Width="350" 
                                    Height="620"
                                    Padding="14"
                                    Margin="0,0,16,16">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto"
                                      RowSpacing="6">

                                    <!-- List Header -->
                                    <StackPanel Grid.Row="0" Spacing="6">
                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontWeight="Bold"
                                                           FontSize="15"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                <Button Grid.Column="1"
                                                        Classes="Icon"
                                                        Width="28"
                                                        Height="28"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        ToolTip.Tip="Delete List"
                                                        IsEnabled="{ReflectionBinding DataContext.CanEditLists, ElementName=RootView}"
                                                        Click="DeleteList_Click">
                                                    <PathIcon Data="{StaticResource Icon_Trash}"
                                                              Width="13"
                                                              Height="13"
                                                              Foreground="{StaticResource ErrorBrush}"/>
                                                </Button>
                                            </Grid>
                                            
                                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}">
                                                    <Run Text="{Binding TotalAmount, StringFormat='Rs. {0:N0}'}"/>
                                                    <Run Text="{Binding AmountLimitText}" 
                                                         Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                                         FontWeight="Normal"/>
                                                </TextBlock>
                                                <Border Grid.Column="1"
                                                        Padding="6,2"
                                                        Background="{DynamicResource AppHoverBrush}"
                                                        CornerRadius="4"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Count, StringFormat='{}{0} accounts'}"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource L_List_Mode}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1"
                                                      Width="170"
                                                      Height="30"
                                                      Classes="ModeSelector"
                                                      ItemsSource="{Binding PaymentModes}"
                                                      SelectedItem="{Binding SelectedPaymentMode}"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                            <Border Padding="8,4"
                                                    CornerRadius="4"
                                                    Tag="{Binding StatusTag}">
                                                <Border.Styles>
                                                    <Style Selector="Border">
                                                        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                                                    </Style>
                                                    <Style Selector="Border[Tag=Pending]">
                                                        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                                                    </Style>
                                                    <Style Selector="Border[Tag=Processing]">
                                                        <Setter Property="Background" Value="{DynamicResource InfoTintBrush}"/>
                                                    </Style>
                                                    <Style Selector="Border[Tag=Success]">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}"/>
                                                    </Style>
                                                    <Style Selector="Border[Tag=Failed]">
                                                        <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
                                                    </Style>
                                                </Border.Styles>
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            </Border>

                                            <Border Classes="ListSpinner Spinner"
                                                    IsVisible="{Binding IsProcessingState}">
                                                <Border Width="4"
                                                        Height="4"
                                                        CornerRadius="2"
                                                        Background="{StaticResource AccentBlueBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top"
                                                        Margin="0,1,0,0"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding FailureReason}"
                                                   IsVisible="{Binding HasFailureReason}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                                        <Border Background="{DynamicResource ListDuplicateTintBrush}"
                                                BorderBrush="{DynamicResource ListDuplicateBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,5"
                                                IsVisible="{Binding IsDuplicateFocus}">
                                            <TextBlock Text="Duplicate found here"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <Separator Grid.Row="1"/>

                                    <!-- Inline Add -->
                                    <Border Grid.Row="2"
                                            Background="{DynamicResource AppHoverBrush}"
                                            CornerRadius="6"
                                            Padding="6">
                                        <Grid ColumnDefinitions="*,80" ColumnSpacing="6">
                                            <TextBox Text="{Binding PendingAccountNo, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="{DynamicResource L_List_WatermarkAccountNo}"
                                                     Tag="AccountInput"
                                                     IsEnabled="{ReflectionBinding DataContext.CanEditLists, ElementName=RootView}"
                                                     MaxLength="12"
                                                     Padding="8,5"
                                                     MinHeight="32"
                                                     FontSize="12"
                                                     FontFamily="{StaticResource AppMonoFontFamily}"
                                                     KeyDown="PendingField_KeyDown"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding PendingInstallmentText, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="{DynamicResource L_List_WatermarkInst}"
                                                     Tag="{Binding InstallmentInputTag}"
                                                     IsEnabled="{ReflectionBinding DataContext.CanEditLists, ElementName=RootView}"
                                                     HorizontalContentAlignment="Center"
                                                     Padding="8,5"
                                                     MinHeight="32"
                                                     FontSize="12"
                                                     FontFamily="{StaticResource AppMonoFontFamily}"
                                                     KeyDown="PendingField_KeyDown"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="3" Spacing="2">
                                        <TextBlock Text="{DynamicResource L_List_EnterHint}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding InstallmentSuggestionHint}"
                                                   FontSize="10"
                                                   IsVisible="{Binding HasInstallmentSuggestionHint}"
                                                   Foreground="{DynamicResource WarningBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="4"
                                               Text="{Binding EntryMessage}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasEntryMessage}"
                                               Foreground="{Binding EntryMessageForeground}"/>

                                    <Grid Grid.Row="5" ColumnDefinitions="*,64,32" ColumnSpacing="8">
                                        <TextBlock Text="{DynamicResource L_List_ColumnAccountNo}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource L_List_ColumnInst}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </Grid>

                                    <!-- Account List (Spacious Scroll Area) -->
                                    <ScrollViewer Grid.Row="6"
                                                  MinHeight="140">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ListItem">
                                                    <Border Padding="8,6" 
                                                            Margin="0,2"
                                                            CornerRadius="4">
                                                        <Border.Styles>
                                                            <Style Selector="Border">
                                                                <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                            </Style>
                                                            <Style Selector="Border[Tag=AdvancePayment]">
                                                                <Setter Property="Background" Value="{DynamicResource ListAdvanceTintBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ListAdvanceBorderBrush}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </Style>
                                                            <Style Selector="Border[Tag=CatchUpPayment]">
                                                                <Setter Property="Background" Value="{DynamicResource ListCatchUpTintBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ListCatchUpBorderBrush}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </Style>
                                                            <Style Selector="Border[Tag=PartialCatchUpPayment]">
                                                                <Setter Property="Background" Value="{DynamicResource ListPartialCatchUpTintBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ListPartialCatchUpBorderBrush}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </Style>
                                                            <Style Selector="Border[Tag=MissingDueDate]">
                                                                <Setter Property="Background" Value="{DynamicResource ListMissingDueTintBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ListMissingDueBorderBrush}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </Style>
                                                            <Style Selector="Border[Tag=Invalid]">
                                                                <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </Style>
                                                            <Style Selector="Border[Tag=Duplicate]">
                                                                <Setter Property="Background" Value="{DynamicResource ListDuplicateTintBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ListDuplicateBorderBrush}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </Style>
                                                            <Style Selector="Border[Tag=Processed]">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </Style>
                                                        </Border.Styles>
                                                        
                                                        <Border.Tag>
                                                            <Binding Converter="{StaticResource ListItemToTagConverter}"/>
                                                        </Border.Tag>

                                                        <Grid ColumnDefinitions="4,*,64,32" ColumnSpacing="8"
                                                              VerticalAlignment="Center">
                                                            <Border Width="4"
                                                                    CornerRadius="2"
                                                                    Background="{DynamicResource ListDuplicateBorderBrush}"
                                                                    IsVisible="{Binding IsDuplicateFocus}"/>
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding AccountNo}" 
                                                                           FontFamily="{StaticResource AppMonoFontFamily}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding EstimatedOpeningDateDisplay, StringFormat='Opened: {0}'}"
                                                                           FontSize="10"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                                <ToolTip.Tip>
                                                                    <Border Background="{DynamicResource AppCardBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Padding="10"
                                                                            MaxWidth="320">
                                                                        <StackPanel Spacing="4">
                                                                            <TextBlock Text="{Binding AccountNo, StringFormat='Account: {0}'}"
                                                                                        FontWeight="SemiBold"/>
                                                                            <TextBlock Text="{Binding AccountNameDisplay, StringFormat='Name: {0}'}"/>
                                                                            <TextBlock Text="{Binding DenominationDisplay, StringFormat='Amount: {0}'}"/>
                                                                            <TextBlock Text="{Binding NextInstallmentDateDisplay, StringFormat='Next Due: {0}'}"/>
                                                                            <TextBlock Text="{Binding DueMonthDisplay, StringFormat='Due Month: {0}'}"/>
                                                                            <TextBlock Text="{Binding NextDueAfterPaymentDisplay, StringFormat='Next Due After Payment: {0}'}"/>
                                                                            <TextBlock Text="{Binding Installment, StringFormat='Installments: {0}'}"/>
                                                                            <TextBlock Text="{Binding TotalAmount, StringFormat='List Amount: Rs. {0:N0}'}"/>
                                                                            <TextBlock Text="{Binding PaymentCategoryLabel, StringFormat='Payment Type: {0}'}"/>
                                                                            <TextBlock Text="{Binding PaymentSummary, StringFormat='Payment Flow: {0}'}"
                                                                                        TextWrapping="Wrap"/>
                                                                            <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </ToolTip.Tip>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Installment}"
                                                                       FontSize="12"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                            <Button Grid.Column="3"
                                                                    Classes="Icon"
                                                                    Tag="RowDelete"
                                                                    Width="28"
                                                                    Height="28"
                                                                    Padding="0"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Click="RemoveAccount_Click">
                                                                <Viewbox Width="14" Height="14" Stretch="Uniform">
                                                                    <Canvas Width="16" Height="16">
                                                                        <Path Fill="{DynamicResource AppTextPrimaryBrush}"
                                                                              Data="M6 1H10C10.55 1 11 1.45 11 2V3H14V5H13V13.5C13 14.33 12.33 15 11.5 15H4.5C3.67 15 3 14.33 3 13.5V5H2V3H5V2C5 1.45 5.45 1 6 1ZM7 3H9V2.5H7V3ZM5 5V13H11V5H5ZM6.5 6.5H8V11.5H6.5V6.5ZM8.5 6.5H10V11.5H8.5V6.5Z"/>
                                                                    </Canvas>
                                                                </Viewbox>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Clear Button -->
                                    <Button Grid.Row="7"
                                            Classes="Danger" 
                                            Command="{Binding ClearCommand}"
                                            HorizontalAlignment="Stretch"
                                            Content="{DynamicResource L_List_ClearList}"
                                            MinHeight="34"
                                            Margin="0,6,0,0"
                                            Padding="8"/>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Classes="Card"
                Padding="12"
                Margin="0,0,130,0">
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto,*,Auto,*"
                  ColumnSpacing="8">
                <Border Width="14" Height="14"
                        Background="{DynamicResource ListAdvanceTintBrush}"
                        BorderBrush="{DynamicResource ListAdvanceBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="4"/>
                <TextBlock Grid.Column="1"
                           Text="{DynamicResource L_List_LegendAdvancePayment}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                <Border Grid.Column="2"
                        Width="14" Height="14"
                        Background="{DynamicResource ListCatchUpTintBrush}"
                        BorderBrush="{DynamicResource ListCatchUpBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="4"/>
                <TextBlock Grid.Column="3"
                           Text="{DynamicResource L_List_LegendCatchUp}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                <Border Grid.Column="4"
                        Width="14" Height="14"
                        Background="{DynamicResource ListPartialCatchUpTintBrush}"
                        BorderBrush="{DynamicResource ListPartialCatchUpBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="4"/>
                <TextBlock Grid.Column="5"
                           Text="{DynamicResource L_List_LegendPartialCatchUp}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                <Border Grid.Column="6"
                        Width="14" Height="14"
                        Background="{DynamicResource ListMissingDueTintBrush}"
                        BorderBrush="{DynamicResource ListMissingDueBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="4"/>
                <TextBlock Grid.Column="7"
                           Text="{DynamicResource L_List_LegendMissingDue}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                <Border Grid.Column="8"
                        Width="14" Height="14"
                        Background="{DynamicResource SuccessTintBrush}"
                        BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="2"
                        CornerRadius="4"/>
                <TextBlock Grid.Column="9"
                           Text="Processed in run"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                <Border Grid.Column="10"
                        Width="14" Height="14"
                        Background="{DynamicResource AppCardBackgroundBrush}"
                        BorderBrush="{DynamicResource SuggestionBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="4"/>
                <TextBlock Grid.Column="11"
                           Text="Auto-suggested installments"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </Grid>
        </Border>

        <Grid Grid.RowSpan="4"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,36,118"
              Panel.ZIndex="60">
            <StackPanel Spacing="10"
                        HorizontalAlignment="Right">
                <Button Classes="Primary"
                        MinWidth="168"
                        Height="52"
                        Padding="16,10"
                        IsVisible="{Binding ShowValidationLauncher}"
                        Command="{Binding OpenValidationPanelCommand}"
                        ToolTip.Tip="Open account check">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{DynamicResource L_List_ValidationTitle}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ValidationSummaryMessage}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="220"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                </Button>

                <Border Classes="Card"
                        Width="540"
                        Padding="14"
                        IsVisible="{Binding IsValidationPanelOpen}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{DynamicResource L_List_ValidationTitle}"
                                           Classes="SubHeader"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource L_List_ValidationHint}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Classes="Secondary"
                                    MinWidth="64"
                                    Height="34"
                                    Command="{Binding CloseValidationPanelCommand}"
                                    Content="OK"
                                    VerticalAlignment="Top"/>
                        </Grid>

                        <TextBlock Text="{Binding ValidationSummaryMessage}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   TextWrapping="Wrap"/>

                        <WrapPanel>
                            <Border CornerRadius="999"
                                    Padding="10,5"
                                    Margin="0,0,8,8"
                                    Tag="Idle">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}">
                                    <Run Text="{DynamicResource L_List_ValidationChecked}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding ValidationCheckedCount}"/>
                                </TextBlock>
                            </Border>
                            <Border CornerRadius="999"
                                    Padding="10,5"
                                    Margin="0,0,8,8"
                                    Tag="Ready">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}">
                                    <Run Text="{DynamicResource L_List_ValidationReady}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding ValidationReadyCount}"/>
                                </TextBlock>
                            </Border>
                            <Border CornerRadius="999"
                                    Padding="10,5"
                                    Margin="0,0,8,8"
                                    Tag="Review">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}">
                                    <Run Text="{DynamicResource L_List_ValidationReview}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding ValidationReviewCount}"/>
                                </TextBlock>
                            </Border>
                            <Border CornerRadius="999"
                                    Padding="10,5"
                                    Margin="0,0,8,8"
                                    Tag="Blocked">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}">
                                    <Run Text="{DynamicResource L_List_ValidationBlocked}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding ValidationBlockedCount}"/>
                                </TextBlock>
                            </Border>
                        </WrapPanel>

                        <Border Background="{DynamicResource AppHoverBrush}"
                                CornerRadius="8"
                                Padding="10"
                                ClipToBounds="True">
                            <ScrollViewer MaxHeight="230"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ValidationChecks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AccountCheckResult">
                                            <Border Tag="{Binding StatusTag}"
                                                    CornerRadius="8"
                                                    Padding="10"
                                                    Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="96,*,92" ColumnSpacing="10">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding ListLabel}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding AccountNo}"
                                                                   FontFamily="{StaticResource AppMonoFontFamily}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding AccountName}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding DetailText}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2"
                                                            Tag="{Binding StatusTag}"
                                                            CornerRadius="999"
                                                            Padding="10,6"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

    </Grid>

</UserControl>
