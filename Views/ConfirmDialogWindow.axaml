<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:AgentBuddy.Models"
        x:Class="AgentBuddy.Views.ConfirmDialogWindow"
        x:DataType="models:ConfirmDialogRequest"
        mc:Ignorable="d"
        Width="460"
        MinWidth="380"
        MaxWidth="560"
        SizeToContent="Height"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        ShowInTaskbar="False"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">

    <Border Classes="DialogBackdrop">
        <Border Classes="DialogSurface">
            <Grid RowDefinitions="Auto,Auto,Auto"
                  RowSpacing="16">
                <StackPanel Grid.Row="0"
                            Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="DialogDot"/>
                        <TextBlock Text="Action Required"
                                   Classes="Kicker"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Title}"
                               Classes="DialogTitle"/>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"
                           MaxWidth="500"
                           Classes="DialogBody"/>

                <Grid Grid.Row="2"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="12">
                    <Border Classes="DialogDivider"
                            Margin="0,2"/>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10">
                        <Button Classes="Secondary"
                                Content="{Binding NoText}"
                                Click="No_Click"
                                IsCancel="True"
                                Padding="16,8"/>
                        <Button Classes="Primary"
                                Content="{Binding YesText}"
                                Click="Yes_Click"
                                IsDefault="True"
                                Padding="16,8"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
