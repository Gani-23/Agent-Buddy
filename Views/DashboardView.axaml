<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AgentBuddy.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="AgentBuddy.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Styles>
        <Style Selector="Border[Tag=RenewalMissing]">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Border[Tag=RenewalNormal]">
            <Setter Property="Background" Value="{DynamicResource InfoTintBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InfoEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Border[Tag=RenewalUrgent]">
            <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Border.DashboardHeader">
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BoxShadow" Value="{DynamicResource AppCardShadow}"/>
        </Style>
        <Style Selector="Border.DashboardSearch">
            <Setter Property="Background" Value="{DynamicResource AppSidebarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="Border.DashboardBadge">
            <Setter Property="Background" Value="{DynamicResource AppSidebarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="Border.MetricCard.FeaturedMetric">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.MetricIcon">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.DefaultSummaryCard">
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BoxShadow" Value="{DynamicResource AppCardShadow}"/>
        </Style>
        <Style Selector="Border.CountPill">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.CountPill TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.SummaryMiniStat">
            <Setter Property="Background" Value="{DynamicResource AppSidebarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <vm:DashboardViewModel/>
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" Margin="0,0,0,24" HorizontalAlignment="Stretch">

            <Border Classes="DashboardHeader">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                        <StackPanel Grid.Column="0" Spacing="4" Width="310">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Classes="TileDot" Background="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{DynamicResource L_Dash_Kicker}" Classes="Kicker" VerticalAlignment="Center" Margin="0"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource L_Dash_Title}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       LineHeight="30"
                                       Margin="0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource L_Dash_Subtitle}"
                                   Classes="SectionLead"
                                   TextWrapping="Wrap"
                                   MaxWidth="620"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>

                        <WrapPanel Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   IsVisible="{Binding !IsLoading}">
                            <Button Classes="Secondary" Command="{Binding RefreshCommand}" Margin="0,0,8,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_Sync}" Width="14" Height="14" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource L_Common_Refresh}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Classes="Secondary"
                                    Click="SyncMobileQr_Click"
                                    Margin="0,0,8,0"
                                    ToolTip.Tip="Sync accounts with the mobile app over Wi-Fi using a QR code">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_QrCode}" Width="14" Height="14" Foreground="{StaticResource AccentGreenBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Sync mobile (QR)" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Classes="Hero"
                                    Command="{Binding UpdateDatabaseCommand}"
                                    Margin="0"
                                    IsEnabled="{Binding !IsBusy}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_Plus}" Width="14" Height="14" Foreground="White"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource L_Dash_UpdateDatabase}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Classes="Primary"
                                    Command="{Binding OpenUpdateLinkCommand}"
                                    Margin="8,0,0,0"
                                    IsVisible="{Binding IsUpdateAvailable}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_Sparkle}" Width="14" Height="14" Foreground="White"/>
                                    <TextBlock Grid.Column="1" Text="{Binding UpdateButtonText}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </WrapPanel>
                    </Grid>

                    <Border Grid.Row="1" Classes="DashboardSearch" IsVisible="{Binding !IsLoading}">
                        <Grid ColumnDefinitions="230,*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Search all accounts"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <TextBlock Text="By account number or customer name"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            </StackPanel>

                            <TextBox x:Name="SearchAllAccountsTextBox"
                                     Grid.Column="1"
                                     Text="{Binding GlobalAccountSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{DynamicResource L_Search_Watermark}"
                                     VerticalAlignment="Center"
                                     KeyDown="SearchAllAccountsBox_KeyDown"/>

                            <Button Grid.Column="2"
                                    Classes="Secondary"
                                    VerticalAlignment="Center"
                                    Click="SearchAllAccounts_Click">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_Search}" Width="14" Height="14" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource L_Common_Search}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Classes="Card" Padding="28" IsVisible="{Binding IsLoading}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource L_Dash_Loading}" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <ProgressBar IsIndeterminate="True" Width="220"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Classes="Skeleton" Height="96"/>
                        <Border Grid.Column="1" Classes="Skeleton" Height="96"/>
                        <Border Grid.Column="2" Classes="Skeleton" Height="96"/>
                        <Border Grid.Column="3" Classes="Skeleton" Height="96"/>
                    </Grid>
                    <Border Classes="Skeleton" Height="180"/>
                </StackPanel>
            </Border>

            <StackPanel Spacing="18" IsVisible="{Binding !IsLoading}">
                <!-- License Grace Period / Expiring Soon Alert Banner -->
                <Border Classes="Card"
                        Padding="0"
                        Background="{DynamicResource DangerTintBrush}"
                        BorderBrush="{DynamicResource DangerEdgeBrush}"
                        BorderThickness="1"
                        IsVisible="{Binding HasLicenseNotice}">
                    <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="0">
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="14,12">
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="12"
                                    Background="{DynamicResource AppCardBackgroundBrush}"
                                    BorderBrush="{StaticResource ErrorBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource Icon_Shield}"
                                          Width="18"
                                          Height="18"
                                          Foreground="{StaticResource ErrorBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="License renewal"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TintTextBrush}"/>
                                <TextBlock Text="{Binding LicenseWarningMessage}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TintTextBrush}"/>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Grid.Column="2"
                                   Margin="0,12,14,4"
                                   VerticalAlignment="Center">
                            <Button Classes="Primary"
                                    Padding="14,8"
                                    Click="NavigateToSettings_Click"
                                    Content="Manage license"
                                    Margin="0,0,8,8"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Classes="Card"
                        Padding="0"
                        Background="{DynamicResource WarningTintBrush}"
                        BorderBrush="{DynamicResource WarningEdgeBrush}"
                        BorderThickness="1"
                        IsVisible="{Binding HasNewAccountsMissingAslaasNotice}">
                    <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="0">
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="14,12">
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="12"
                                    Background="{DynamicResource AppCardBackgroundBrush}"
                                    BorderBrush="{StaticResource WarningBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="!"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L_Dash_AslaasReminderTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TintTextBrush}"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource TintTextBrush}">
                                    <Run Text="{Binding NewAccountsMissingAslaasCount}"/>
                                    <Run Text="{DynamicResource L_Dash_AslaasReminderBody}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Grid.Column="2"
                                   Margin="0,12,14,4"
                                   VerticalAlignment="Center">
                                <Button Classes="Primary"
                                        Padding="14,8"
                                        Command="{Binding UpdateNewAccountAslaasCommand}"
                                        IsEnabled="{Binding !IsBusy}"
                                        Content="{DynamicResource L_Dash_UpdateAslaasNow}"
                                        Margin="0,0,8,8"/>
                                <Button Classes="Secondary"
                                        Padding="14,8"
                                        Tag="new-accounts"
                                        Click="OpenSegment_Click"
                                        Content="{DynamicResource L_Common_ViewAccounts}"
                                        Margin="0,0,0,8"/>
                            </WrapPanel>
                    </Grid>
                </Border>

                <Border Classes="Card"
                        Padding="0"
                        IsVisible="{Binding ShowRdRenewalBanner}"
                        Tag="{Binding RdCertificateRenewalTag}">
                    <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="0">
                        <StackPanel Grid.Column="1" Spacing="4" Margin="14,12">
                                <TextBlock Text="Postal RD certificate"
                                           Classes="Kicker"/>
                                <TextBlock Text="{Binding RdCertificateRenewalHeadline}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TintTextBrush}"/>
                                <TextBlock Text="{Binding RdCertificateRenewalMessage}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TintTextBrush}"/>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Classes="DashboardBadge"
                                    Margin="0,12,14,12"
                                    VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding RdCertificateRenewalCountdown}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding RdCertificateRenewalDateDisplay}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                    </Grid>
                </Border>



                <!-- ================= TODAY ================= -->
                <Border Classes="SectionCard Stagger Delay1" Padding="20">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Today" Classes="SubHeader" Margin="0"/>
                                <TextBlock Text="{Binding TodayHeadline}" Classes="SectionLead"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Bottom" FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       Text="Reminders send a PDF due list to WhatsApp"/>
                        </Grid>

                        <UniformGrid Columns="4" Classes="TodayGrid">
                            <!-- 15th deadline -->
                            <Border Classes="StatTile TodayCard TintWarning" Classes.DueNow="{Binding IsFirstHalfOfMonth}"
                                    Tag="pending-first-half" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Margin="0,0,12,0">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Classes="IconChip" Background="{DynamicResource WarningTintBrush}">
                                            <PathIcon Data="{StaticResource Icon_Calendar}" Width="16" Height="16" Foreground="{DynamicResource WarningBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="By the 15th" Classes="TileTitle"/>
                                            <TextBlock Text="{Binding FirstHalfDeadlineLabel}" Classes="TileMeta"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="NowPill" IsVisible="{Binding IsFirstHalfOfMonth}" VerticalAlignment="Top">
                                            <TextBlock Text="Due now"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="TileValue">
                                            <Run Text="{Binding FirstHalfDeadlineCount}"/>
                                            <Run Text="accounts" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        </TextBlock>
                                        <TextBlock Classes="TileMeta" Text="{Binding FirstHalfDeadlineAmount, StringFormat='₹{0:N0} to collect'}"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Button Classes="Primary TileAction" Tag="pending-first-half" Click="SmartAutomation_Click" HorizontalAlignment="Stretch"
                                                ToolTip.Tip="Create the due-list PDF, copy it, and open WhatsApp">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <PathIcon Data="{StaticResource Icon_WhatsApp}" Width="13" Height="13"/>
                                                <TextBlock Text="Send reminders"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Classes="TileMenu" ToolTip.Tip="More actions">
                                            <TextBlock Text="•••" FontSize="10"/>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="View accounts" Tag="pending-first-half" Click="OpenSegment_Click"/>
                                                    <MenuItem Header="Search in list" Tag="pending-first-half" Click="SearchSegment_Click"/>
                                                    <MenuItem Header="Print list" Tag="pending-first-half" Click="PrintSegment_Click"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Month-end deadline -->
                            <Border Classes="StatTile TodayCard TintInfo" Classes.DueNow="{Binding IsSecondHalfOfMonth}"
                                    Tag="pending-second-half" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Margin="0,0,12,0">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Classes="IconChip" Background="{DynamicResource InfoTintBrush}">
                                            <PathIcon Data="{StaticResource Icon_Clock}" Width="16" Height="16" Foreground="{DynamicResource InfoBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="By month-end" Classes="TileTitle"/>
                                            <TextBlock Text="{Binding SecondHalfDeadlineLabel}" Classes="TileMeta"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="NowPill" IsVisible="{Binding IsSecondHalfOfMonth}" VerticalAlignment="Top">
                                            <TextBlock Text="Due now"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="TileValue">
                                            <Run Text="{Binding SecondHalfDeadlineCount}"/>
                                            <Run Text="accounts" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        </TextBlock>
                                        <TextBlock Classes="TileMeta" Text="{Binding SecondHalfDeadlineAmount, StringFormat='₹{0:N0} to collect'}"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Button Classes="Primary TileAction" Tag="pending-second-half" Click="SmartAutomation_Click" HorizontalAlignment="Stretch"
                                                ToolTip.Tip="Create the due-list PDF, copy it, and open WhatsApp">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <PathIcon Data="{StaticResource Icon_WhatsApp}" Width="13" Height="13"/>
                                                <TextBlock Text="Send reminders"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Classes="TileMenu" ToolTip.Tip="More actions">
                                            <TextBlock Text="•••" FontSize="10"/>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="View accounts" Tag="pending-second-half" Click="OpenSegment_Click"/>
                                                    <MenuItem Header="Search in list" Tag="pending-second-half" Click="SearchSegment_Click"/>
                                                    <MenuItem Header="Print list" Tag="pending-second-half" Click="PrintSegment_Click"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Last chance -->
                            <Border Classes="StatTile TodayCard TintDanger"
                                    Tag="critical-discontinuation" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Margin="0,0,12,0">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Classes="IconChip" Background="{DynamicResource DangerTintBrush}">
                                            <PathIcon Data="{StaticResource Icon_Alert}" Width="16" Height="16" Foreground="{DynamicResource ErrorBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="Last chance" Classes="TileTitle"/>
                                            <TextBlock Text="5–6 months overdue" Classes="TileMeta"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="TileValue">
                                            <Run Text="{Binding CriticalDiscontinuationCount}"/>
                                            <Run Text="accounts" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        </TextBlock>
                                        <TextBlock Classes="TileMeta" Text="About to be discontinued"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Button Classes="Secondary TileAction" Tag="critical-discontinuation" Click="SmartAutomation_Click" HorizontalAlignment="Stretch"
                                                ToolTip.Tip="Create the discontinuation warning PDF, copy it, and open WhatsApp">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <PathIcon Data="{StaticResource Icon_WhatsApp}" Width="13" Height="13" Foreground="{DynamicResource ErrorBrush}"/>
                                                <TextBlock Text="Warn customers"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Classes="TileMenu" ToolTip.Tip="More actions">
                                            <TextBlock Text="•••" FontSize="10"/>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="View accounts" Tag="critical-discontinuation" Click="OpenSegment_Click"/>
                                                    <MenuItem Header="Search in list" Tag="critical-discontinuation" Click="SearchSegment_Click"/>
                                                    <MenuItem Header="Print list" Tag="critical-discontinuation" Click="PrintSegment_Click"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Rebate pitch -->
                            <Border Classes="StatTile TodayCard TintSuccess"
                                    Tag="rebate-upsell" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Classes="IconChip" Background="{DynamicResource SuccessTintBrush}">
                                            <PathIcon Data="{StaticResource Icon_Sparkle}" Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="Rebate pitch" Classes="TileTitle"/>
                                            <TextBlock Text="6-month advance prospects" Classes="TileMeta"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="TileValue">
                                            <Run Text="{Binding RebateUpsellCount}"/>
                                            <Run Text="accounts" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        </TextBlock>
                                        <TextBlock Classes="TileMeta" Text="{Binding RebateUpsellAmount, StringFormat='Up to ₹{0:N0} in advance'}"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Button Classes="Secondary TileAction" Tag="rebate-upsell" Click="SmartAutomation_Click" HorizontalAlignment="Stretch"
                                                ToolTip.Tip="Create the rebate eligibility PDF, copy it, and open WhatsApp">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <PathIcon Data="{StaticResource Icon_WhatsApp}" Width="13" Height="13" Foreground="{DynamicResource SuccessBrush}"/>
                                                <TextBlock Text="Share offer"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Classes="TileMenu" ToolTip.Tip="More actions">
                                            <TextBlock Text="•••" FontSize="10"/>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="View accounts" Tag="rebate-upsell" Click="OpenSegment_Click"/>
                                                    <MenuItem Header="Search in list" Tag="rebate-upsell" Click="SearchSegment_Click"/>
                                                    <MenuItem Header="Print list" Tag="rebate-upsell" Click="PrintSegment_Click"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ================= PORTFOLIO ================= -->
                <Border Classes="DefaultSummaryCard Stagger Delay2" Padding="20">
                    <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Top">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Portfolio" Classes="SubHeader" Margin="0"/>
                                <TextBlock Text="All active RD accounts" Classes="SectionLead"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="Secondary" Click="SearchDefaultSummary_Click" Content="Search accounts"/>
                                <Button Classes="Primary" Click="OpenDefaultSummary_Click" Content="View all accounts"/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="4">
                            <Border Classes="Metric" Margin="0,0,12,0">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource Icon_User}" Width="14" Height="14" Foreground="{DynamicResource InfoBrush}"/>
                                        <TextBlock Text="Active accounts" Classes="MetricLabel"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalAccounts}" Classes="MetricValue"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="Metric" Margin="0,0,12,0">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource Icon_Database}" Width="14" Height="14" Foreground="{DynamicResource InfoBrush}"/>
                                        <TextBlock Text="Monthly portfolio" Classes="MetricLabel"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat='₹{0:N0}'}" Classes="MetricValue"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="Metric Clickable" Margin="0,0,12,0" Tag="pending-month" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True"
                                    ToolTip.Tip="View accounts still pending this month">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource Icon_Clock}" Width="14" Height="14" Foreground="{DynamicResource WarningBrush}"/>
                                        <TextBlock Text="Pending this month" Classes="MetricLabel"/>
                                    </StackPanel>
                                    <TextBlock Classes="MetricValue">
                                        <Run Text="{Binding PendingThisMonthCount}"/>
                                        <Run Text="accounts" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Classes="TileMeta" Text="{Binding PendingThisMonthAmount, StringFormat='₹{0:N0} still to collect'}"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="Metric">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource Icon_Check}" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="Deposited this month" Classes="MetricLabel"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DepositedThisMonthAmount, StringFormat='₹{0:N0}'}" Classes="MetricValue"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Classes="LinkButton" Tag="deposited-first-half" Click="OpenSegment_Click"
                                                Content="{Binding FirstHalfDepositedWindowCount, StringFormat='1st half · {0}'}"/>
                                        <Button Classes="LinkButton" Tag="deposited-second-half" Click="OpenSegment_Click"
                                                Content="{Binding SecondHalfDepositedWindowCount, StringFormat='2nd half · {0}'}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Classes="Card" Padding="16" IsVisible="{Binding HasUpdateStatus}">
                    <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Border>

                <Border Classes="SectionCard Stagger Delay3" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Opportunities &amp; risks" Classes="SubHeader"/>

                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                            <!-- Row 0: Rebate Upsell Prospects -->
                            <Border Grid.Row="0" Grid.Column="0" Tag="defaulters" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Classes="StatTile TintWarning">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="Defaulters (4+ months)" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding DefaulterAccountsCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="Revival fee required" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBlock Classes="TileLink" Text="View accounts →" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Tag="vip-accounts" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Classes="StatTile TintSuccess">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="High-value accounts" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding VipAccountsCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Classes="TileMeta">
                                        <Run Text="₹"/><Run Text="{Binding VipAccountsAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBlock Classes="TileLink" Text="View accounts →" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Tag="at-risk-accounts" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Classes="StatTile TintWarning">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="At risk (1–3 months overdue)" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding AtRiskAccountsCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="Monthly penalty applies" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBlock Classes="TileLink" Text="View accounts →" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Classes="StatTile TintInfo">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="Commission forecast" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue" Foreground="{DynamicResource SuccessBrush}">
                                        <Run Text="₹"/><Run Text="{Binding PendingCommissionForecast, StringFormat=N0}"/>
                                    </TextBlock>
                                    <TextBlock Text="Estimated 4% of this month's pending" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Tag="loan-eligible" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Classes="StatTile TintInfo">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="Eligible for 50% loan" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding EligibleForLoanCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="12+ instalments paid" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBlock Classes="TileLink" Text="View accounts →" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Tag="premature-closure" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Classes="StatTile TintInfo">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="Premature closure prospects" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding EligibleForPrematureClosureCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="36+ instalments paid" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBlock Classes="TileLink" Text="View accounts →" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="SectionCard Stagger Delay4" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource L_Dash_ActionCenter}" Classes="SubHeader"/>

                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                            <Border Grid.Row="0" Grid.Column="0" Tag="next-month" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Classes="StatTile TintInfo">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_NextMonthCollection}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding NextMonthCollectionCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Classes="TileMeta">
                                        <Run Text="₹"/><Run Text="{Binding NextMonthCollectionAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBlock Classes="TileLink" Text="View accounts →" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="TileMenu" ToolTip.Tip="More actions">
                                            <TextBlock Text="•••" FontSize="10"/>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="Search in list" Tag="next-month" Click="SearchSegment_Click"/>
                                                    <MenuItem Header="Print list" Tag="next-month" Click="PrintSegment_Click"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Tag="advanced-paid" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Classes="StatTile TintWarning">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_AdvancePaid}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding AdvancedPaidCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Classes="TileMeta">
                                        <Run Text="₹"/><Run Text="{Binding AdvancedPaidAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBlock Classes="TileLink" Text="View accounts →" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="TileMenu" ToolTip.Tip="More actions">
                                            <TextBlock Text="•••" FontSize="10"/>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="Search in list" Tag="advanced-paid" Click="SearchSegment_Click"/>
                                                    <MenuItem Header="Print list" Tag="advanced-paid" Click="PrintSegment_Click"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Tag="new-accounts" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Classes="StatTile TintInfo">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Classes="TileDot"/>
                                            <TextBlock Text="{DynamicResource L_Dash_NewAccountsRecent}"
                                                       Classes="TileTitle"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource SuccessTintBrush}"
                                                BorderBrush="{StaticResource SuccessBrush}"
                                                BorderThickness="1"
                                                CornerRadius="999"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasNewAccountsRibbon}">
                                            <TextBlock Text="NEW"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource SuccessBrush}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding NewAccounts30DaysCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Classes="TileMeta">
                                        <Run Text="₹"/><Run Text="{Binding NewAccounts30DaysAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBlock Classes="TileLink" Text="View accounts →" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="TileMenu" ToolTip.Tip="More actions">
                                            <TextBlock Text="•••" FontSize="10"/>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="Search in list" Tag="new-accounts" Click="SearchSegment_Click"/>
                                                    <MenuItem Header="Print list" Tag="new-accounts" Click="PrintSegment_Click"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Tag="freeze-risk" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Classes="StatTile TintWarning">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_AboutToFreeze}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding AboutToFreezeCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Classes="TileMeta">
                                        <Run Text="₹"/><Run Text="{Binding AboutToFreezeAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBlock Classes="TileLink" Text="View accounts →" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="TileMenu" ToolTip.Tip="More actions">
                                            <TextBlock Text="•••" FontSize="10"/>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="Search in list" Tag="freeze-risk" Click="SearchSegment_Click"/>
                                                    <MenuItem Header="Print list" Tag="freeze-risk" Click="PrintSegment_Click"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Tag="due-soon" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Classes="StatTile TintDanger">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_Due30Days}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding AccountsDueSoon.Count}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="Needs action soon" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBlock Classes="TileLink" Text="View accounts →" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="TileMenu" ToolTip.Tip="More actions">
                                            <TextBlock Text="•••" FontSize="10"/>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="Search in list" Tag="due-soon" Click="SearchSegment_Click"/>
                                                    <MenuItem Header="Print list" Tag="due-soon" Click="PrintSegment_Click"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Tag="matured" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Classes="StatTile TintDanger">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_MaturedAccounts}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding MaturedCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Classes="TileMeta">
                                        <Run Text="₹"/><Run Text="{Binding MaturedAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBlock Classes="TileLink" Text="View accounts →" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="TileMenu" ToolTip.Tip="More actions">
                                            <TextBlock Text="•••" FontSize="10"/>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="Search in list" Tag="matured" Click="SearchSegment_Click"/>
                                                    <MenuItem Header="Print list" Tag="matured" Click="PrintSegment_Click"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="0" Tag="closed-accounts" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Classes="StatTile TintDanger">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_ClosedAccounts}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding ClosedAccountsCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Classes="TileMeta">
                                        <Run Text="₹"/><Run Text="{Binding ClosedAccountsAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBlock Classes="TileLink" Text="View accounts →" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="TileMenu" ToolTip.Tip="More actions">
                                            <TextBlock Text="•••" FontSize="10"/>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="Search in list" Tag="closed-accounts" Click="SearchSegment_Click"/>
                                                    <MenuItem Header="Print list" Tag="closed-accounts" Click="PrintSegment_Click"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" Tag="about-to-mature" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Classes="StatTile TintWarning">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="About to mature" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding AboutToMatureCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Classes="TileMeta">
                                        <Run Text="₹"/><Run Text="{Binding AboutToMatureAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBlock Classes="TileLink" Text="View accounts →" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="TileMenu" ToolTip.Tip="More actions">
                                            <TextBlock Text="•••" FontSize="10"/>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="Search in list" Tag="about-to-mature" Click="SearchSegment_Click"/>
                                                    <MenuItem Header="Print list" Tag="about-to-mature" Click="PrintSegment_Click"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Tag="extended-accounts" Tapped="Tile_Tapped" KeyDown="Tile_KeyDown" Focusable="True" Classes="StatTile TintInfo">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_ExtendedAccounts}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding ExtendedAccountsCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Classes="TileMeta">
                                        <Run Text="₹"/><Run Text="{Binding ExtendedAccountsAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBlock Classes="TileLink" Text="View accounts →" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="TileMenu" ToolTip.Tip="More actions">
                                            <TextBlock Text="•••" FontSize="10"/>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="Search in list" Tag="extended-accounts" Click="SearchSegment_Click"/>
                                                    <MenuItem Header="Print list" Tag="extended-accounts" Click="PrintSegment_Click"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="16">
                    <Border Grid.Column="0" Classes="Card Stagger Delay5">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{DynamicResource L_Dash_PortfolioRiskSplit}" Classes="SubHeader"/>
                            <TextBlock Text="{DynamicResource L_Dash_PortfolioRiskHint}"
                                       Classes="SectionLead"
                                       Margin="0,-6,0,0"/>
                            <lvc:PieChart Series="{Binding CategorySeries}"
                                          Height="260"
                                          LegendPosition="Hidden"
                                          LegendTextPaint="{Binding ChartLegendTextPaint}"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,8">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Default" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,8">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Mature" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,8">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource ErrorBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Freeze risk" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,8">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Advanced" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentPinkBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="New" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="Card Stagger Delay6">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{DynamicResource L_Dash_MonthlyWorkloadTrend}" Classes="SubHeader"/>
                            <TextBlock Text="{DynamicResource L_Dash_MonthlyWorkloadHint}"
                                       Classes="SectionLead"
                                       Margin="0,-6,0,0"/>
                            <lvc:CartesianChart Series="{Binding RevenueSeries}"
                                                XAxes="{Binding RevenueXAxes}"
                                                YAxes="{Binding RevenueYAxes}"
                                                Height="260"
                                                LegendPosition="Hidden"
                                                LegendTextPaint="{Binding ChartLegendTextPaint}"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,0">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Accounts" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Earnings (₹)" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
