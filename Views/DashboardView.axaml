<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AgentBuddy.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="AgentBuddy.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Styles>
        <Style Selector="Border[Tag=RenewalMissing]">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border[Tag=RenewalNormal]">
            <Setter Property="Background" Value="{DynamicResource InfoTintBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Border[Tag=RenewalUrgent]">
            <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Border.DashboardHeader">
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BoxShadow" Value="0 2 8 0 #00000008"/>
        </Style>
        <Style Selector="Border.DashboardSearch">
            <Setter Property="Background" Value="{DynamicResource AppSidebarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style Selector="Border.DashboardBadge">
            <Setter Property="Background" Value="{DynamicResource AppSidebarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style Selector="Border.MetricCard.FeaturedMetric">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.MetricIcon">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <vm:DashboardViewModel/>
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" Margin="0,0,0,24" HorizontalAlignment="Stretch">

            <Border Classes="DashboardHeader">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                        <StackPanel Grid.Column="0" Spacing="4" Width="310">
                            <TextBlock Text="{DynamicResource L_Dash_Kicker}" Classes="Kicker"/>
                            <TextBlock Text="{DynamicResource L_Dash_Title}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       LineHeight="30"
                                       Margin="0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource L_Dash_Subtitle}"
                                   Classes="SectionLead"
                                   TextWrapping="Wrap"
                                   MaxWidth="620"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>

                        <WrapPanel Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   IsVisible="{Binding !IsLoading}">
                            <Button Classes="Secondary" Command="{Binding RefreshCommand}" Padding="12,7" Margin="0,0,8,0" Content="{DynamicResource L_Common_Refresh}"/>
                            <Button Classes="Secondary"
                                    Command="{Binding SyncToMobileCommand}"
                                    Padding="12,7"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding !IsBusy}"
                                    Content="{DynamicResource L_Dash_SyncToMobile}"/>
                            <Button Classes="Primary"
                                    Command="{Binding UpdateDatabaseCommand}"
                                    Padding="12,7"
                                    Margin="0"
                                    IsEnabled="{Binding !IsBusy}"
                                    Content="{DynamicResource L_Dash_UpdateDatabase}"/>
                            <Button Classes="Primary"
                                    Command="{Binding OpenUpdateLinkCommand}"
                                    Padding="12,7"
                                    Margin="8,0,0,0"
                                    IsVisible="{Binding IsUpdateAvailable}"
                                    Content="{Binding UpdateButtonText}"/>
                        </WrapPanel>
                    </Grid>

                    <Border Grid.Row="1" Classes="DashboardSearch" IsVisible="{Binding !IsLoading}">
                        <Grid ColumnDefinitions="230,*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Search all accounts"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <TextBlock Text="Find by account number or customer name"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            </StackPanel>

                            <TextBox Grid.Column="1"
                                     Text="{Binding GlobalAccountSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{DynamicResource L_Search_Watermark}"
                                     VerticalAlignment="Center"
                                     KeyDown="SearchAllAccountsBox_KeyDown"/>

                            <Button Grid.Column="2"
                                    Classes="Secondary"
                                    Padding="14,8"
                                    VerticalAlignment="Center"
                                    Click="SearchAllAccounts_Click"
                                    Content="{DynamicResource L_Common_Search}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Classes="Card" Padding="28" IsVisible="{Binding IsLoading}">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource L_Dash_Loading}" FontSize="14" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <StackPanel Spacing="18" IsVisible="{Binding !IsLoading}">
                <Border Classes="Card"
                        Padding="0"
                        Background="{DynamicResource WarningTintBrush}"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1"
                        IsVisible="{Binding HasNewAccountsMissingAslaasNotice}">
                    <Grid ColumnDefinitions="5,*,Auto" ColumnSpacing="0">
                        <Border Background="{StaticResource WarningBrush}" CornerRadius="12,0,0,12"/>
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="14,12">
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="12"
                                    Background="{DynamicResource AppCardBackgroundBrush}"
                                    BorderBrush="{StaticResource WarningBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="!"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L_Dash_AslaasReminderTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TintTextBrush}"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource TintTextBrush}">
                                    <Run Text="{Binding NewAccountsMissingAslaasCount}"/>
                                    <Run Text="{DynamicResource L_Dash_AslaasReminderBody}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Grid.Column="2"
                                   Margin="0,12,14,4"
                                   VerticalAlignment="Center">
                                <Button Classes="Primary"
                                        Padding="14,8"
                                        Command="{Binding UpdateNewAccountAslaasCommand}"
                                        IsEnabled="{Binding !IsBusy}"
                                        Content="{DynamicResource L_Dash_UpdateAslaasNow}"
                                        Margin="0,0,8,8"/>
                                <Button Classes="Secondary"
                                        Padding="14,8"
                                        Tag="new-accounts"
                                        Click="OpenSegment_Click"
                                        Content="{DynamicResource L_Common_ViewAccounts}"
                                        Margin="0,0,0,8"/>
                            </WrapPanel>
                    </Grid>
                </Border>

                <Border Classes="Card"
                        Padding="0"
                        Tag="{Binding RdCertificateRenewalTag}">
                    <Grid ColumnDefinitions="5,*,Auto" ColumnSpacing="0">
                        <Border Background="{StaticResource AccentBlueBrush}" CornerRadius="12,0,0,12"/>
                        <StackPanel Grid.Column="1" Spacing="4" Margin="14,12">
                                <TextBlock Text="Postal RD Certificate Renewal"
                                           Classes="Kicker"/>
                                <TextBlock Text="{Binding RdCertificateRenewalHeadline}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TintTextBrush}"/>
                                <TextBlock Text="{Binding RdCertificateRenewalMessage}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TintTextBrush}"/>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Classes="DashboardBadge"
                                    Margin="0,12,14,12"
                                    VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding RdCertificateRenewalCountdown}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding RdCertificateRenewalDateDisplay}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                    <Border Grid.Column="0" Classes="MetricCard FeaturedMetric">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{DynamicResource L_Dash_TotalAccounts}" Classes="Kicker" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Classes="MetricIcon" Background="{DynamicResource InfoTintBrush}">
                                    <TextBlock Text="#"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBlueBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding TotalAccounts}" Classes="MetricValue"/>
                            <TextBlock Grid.Row="2" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}">
                                    <Run Text="{DynamicResource L_Dash_UpdatedPrefix}"/>
                                    <Run Text="{Binding LastUpdated, StringFormat='{}{0:dd-MMM HH:mm}'}"/>
                                </TextBlock>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="MetricCard FeaturedMetric">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{DynamicResource L_Dash_ActiveAmount}" Classes="Kicker" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Classes="MetricIcon" Background="{DynamicResource SuccessTintBrush}">
                                    <TextBlock Text="Rs"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="1" Classes="MetricValue" Foreground="{StaticResource AccentBlueBrush}">
                                    <Run Text="Rs. "/><Run Text="{Binding TotalAmount, StringFormat=N0}"/>
                                </TextBlock>
                            <TextBlock Grid.Row="2" Text="{DynamicResource L_Dash_ActiveValueHint}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Classes="MetricCard FeaturedMetric">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{DynamicResource L_Dash_Due30Days}" Classes="Kicker" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Classes="MetricIcon" Background="{DynamicResource WarningTintBrush}">
                                    <TextBlock Text="!"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource WarningBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding AccountsDueSoon.Count}" Classes="MetricValue" Foreground="{StaticResource WarningBrush}"/>
                            <WrapPanel Grid.Row="2">
                                    <Button Classes="Secondary" Padding="10,6" Tag="due-soon" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                    <Button Classes="Secondary" Padding="10,6" Tag="due-soon" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                    <Button Classes="Secondary" Padding="10,6" Tag="due-soon" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Classes="Card" Padding="16" IsVisible="{Binding HasUpdateStatus}">
                    <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Border>

                <Border Classes="SectionCard" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="SubHeader">
                            <Run Text="{DynamicResource L_Dash_HalfMonthTitle}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding HalfMonthTitleSuffix}"/>
                        </TextBlock>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                            <Border Grid.Row="0" Grid.Column="0" Classes="StatTile TintDanger">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource L_Dash_FirstHalfPending}" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="22" FontWeight="Bold">
                                        <Run Text="{Binding FirstHalfPendingWindowCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding FirstHalfPendingWindowAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-first-half" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-first-half" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-first-half" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Classes="StatTile TintWarning">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource L_Dash_SecondHalfPending}" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="22" FontWeight="Bold">
                                        <Run Text="{Binding SecondHalfPendingWindowCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding SecondHalfPendingWindowAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-second-half" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-second-half" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-second-half" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Classes="StatTile TintSuccess">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource L_Dash_FirstHalfDeposited}" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="22" FontWeight="Bold">
                                        <Run Text="{Binding FirstHalfDepositedWindowCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding FirstHalfDepositedWindowAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="deposited-first-half" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="deposited-first-half" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="deposited-first-half" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Classes="StatTile TintInfo">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource L_Dash_SecondHalfDeposited}" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="22" FontWeight="Bold">
                                        <Run Text="{Binding SecondHalfDepositedWindowCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding SecondHalfDepositedWindowAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="deposited-second-half" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="deposited-second-half" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="deposited-second-half" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="SectionCard" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource L_Dash_ActionCenter}" Classes="SubHeader"/>

                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                            <Border Grid.Row="0" Grid.Column="0" Classes="StatTile TintSuccess">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource L_Dash_PendingMonth}" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="22" FontWeight="Bold">
                                        <Run Text="{Binding PendingThisMonthCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding PendingThisMonthAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-month" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-month" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-month" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Classes="StatTile TintInfo">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource L_Dash_NextMonthCollection}" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="22" FontWeight="Bold">
                                        <Run Text="{Binding NextMonthCollectionCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding NextMonthCollectionAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="next-month" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="next-month" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="next-month" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="2" Classes="StatTile TintWarning">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource L_Dash_AdvancePaid}" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="22" FontWeight="Bold">
                                        <Run Text="{Binding AdvancedPaidCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding AdvancedPaidAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="advanced-paid" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="advanced-paid" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="advanced-paid" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Classes="StatTile TintInfo">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{DynamicResource L_Dash_NewAccountsRecent}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource SuccessTintBrush}"
                                                BorderBrush="{StaticResource SuccessBrush}"
                                                BorderThickness="1"
                                                CornerRadius="999"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasNewAccountsRibbon}">
                                            <TextBlock Text="NEW"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource SuccessBrush}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock FontSize="22" FontWeight="Bold">
                                        <Run Text="{Binding NewAccounts30DaysCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding NewAccounts30DaysAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="new-accounts" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="new-accounts" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="new-accounts" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Classes="StatTile TintWarning">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource L_Dash_AboutToFreeze}" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="22" FontWeight="Bold">
                                        <Run Text="{Binding AboutToFreezeCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding AboutToFreezeAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="freeze-risk" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="freeze-risk" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="freeze-risk" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="2" Classes="StatTile TintDanger">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource L_Dash_MaturedAccounts}" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="22" FontWeight="Bold">
                                        <Run Text="{Binding MaturedCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding MaturedAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="matured" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="matured" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="matured" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Classes="StatTile TintDanger">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource L_Dash_ClosedAccounts}" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="22" FontWeight="Bold">
                                        <Run Text="{Binding ClosedAccountsCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding ClosedAccountsAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="closed-accounts" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="closed-accounts" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="closed-accounts" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="1" Classes="StatTile TintWarning">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="About To Mature" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="22" FontWeight="Bold">
                                        <Run Text="{Binding AboutToMatureCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding AboutToMatureAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="about-to-mature" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="about-to-mature" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="about-to-mature" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="2" Classes="StatTile TintInfo">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource L_Dash_ExtendedAccounts}" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="22" FontWeight="Bold">
                                        <Run Text="{Binding ExtendedAccountsCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding ExtendedAccountsAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="extended-accounts" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="extended-accounts" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="extended-accounts" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="16">
                    <Border Grid.Column="0" Classes="Card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{DynamicResource L_Dash_PortfolioRiskSplit}" Classes="SubHeader"/>
                            <TextBlock Text="{DynamicResource L_Dash_PortfolioRiskHint}"
                                       Classes="SectionLead"
                                       Margin="0,-6,0,0"/>
                            <lvc:PieChart Series="{Binding CategorySeries}"
                                          Height="260"
                                          LegendPosition="Hidden"
                                          LegendTextPaint="{Binding ChartLegendTextPaint}"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,8">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Default" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,8">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Mature" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,8">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource ErrorBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Freeze Risk" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,8">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Advanced" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentPinkBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="New" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="Card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{DynamicResource L_Dash_MonthlyWorkloadTrend}" Classes="SubHeader"/>
                            <TextBlock Text="{DynamicResource L_Dash_MonthlyWorkloadHint}"
                                       Classes="SectionLead"
                                       Margin="0,-6,0,0"/>
                            <lvc:CartesianChart Series="{Binding RevenueSeries}"
                                                XAxes="{Binding RevenueXAxes}"
                                                YAxes="{Binding RevenueYAxes}"
                                                Height="260"
                                                LegendPosition="Hidden"
                                                LegendTextPaint="{Binding ChartLegendTextPaint}"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,0">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Default accounts" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Earnings (Rs.)" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
