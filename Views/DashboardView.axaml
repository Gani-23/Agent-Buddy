<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AgentBuddy.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="AgentBuddy.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Styles>
        <Style Selector="Border[Tag=RenewalMissing]">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Border[Tag=RenewalNormal]">
            <Setter Property="Background" Value="{DynamicResource InfoTintBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InfoEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Border[Tag=RenewalUrgent]">
            <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Border.DashboardHeader">
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BoxShadow" Value="{DynamicResource AppCardShadow}"/>
        </Style>
        <Style Selector="Border.DashboardSearch">
            <Setter Property="Background" Value="{DynamicResource AppSidebarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="Border.DashboardBadge">
            <Setter Property="Background" Value="{DynamicResource AppSidebarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="Border.MetricCard.FeaturedMetric">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.MetricIcon">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.DefaultSummaryCard">
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BoxShadow" Value="{DynamicResource AppCardShadow}"/>
        </Style>
        <Style Selector="Border.CountPill">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.CountPill TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.SummaryMiniStat">
            <Setter Property="Background" Value="{DynamicResource AppSidebarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <vm:DashboardViewModel/>
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" Margin="0,0,0,24" HorizontalAlignment="Stretch">

            <Border Classes="DashboardHeader">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                        <StackPanel Grid.Column="0" Spacing="4" Width="310">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Classes="TileDot" Background="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{DynamicResource L_Dash_Kicker}" Classes="Kicker" VerticalAlignment="Center" Margin="0"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource L_Dash_Title}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       LineHeight="30"
                                       Margin="0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource L_Dash_Subtitle}"
                                   Classes="SectionLead"
                                   TextWrapping="Wrap"
                                   MaxWidth="620"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>

                        <WrapPanel Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   IsVisible="{Binding !IsLoading}">
                            <Button Classes="Secondary" Command="{Binding RefreshCommand}" Margin="0,0,8,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_Sync}" Width="14" Height="14" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource L_Common_Refresh}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Classes="Secondary"
                                    Click="SyncMobileQr_Click"
                                    Margin="0,0,8,0"
                                    ToolTip.Tip="Sync accounts with Mobile app via Wi-Fi QR code">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_QrCode}" Width="14" Height="14" Foreground="{StaticResource AccentGreenBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Sync Mobile (QR)" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Classes="Hero"
                                    Command="{Binding UpdateDatabaseCommand}"
                                    Margin="0"
                                    IsEnabled="{Binding !IsBusy}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_Plus}" Width="14" Height="14" Foreground="White"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource L_Dash_UpdateDatabase}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Classes="Primary"
                                    Command="{Binding OpenUpdateLinkCommand}"
                                    Margin="8,0,0,0"
                                    IsVisible="{Binding IsUpdateAvailable}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_Sparkle}" Width="14" Height="14" Foreground="White"/>
                                    <TextBlock Grid.Column="1" Text="{Binding UpdateButtonText}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </WrapPanel>
                    </Grid>

                    <Border Grid.Row="1" Classes="DashboardSearch" IsVisible="{Binding !IsLoading}">
                        <Grid ColumnDefinitions="230,*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Search all accounts"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <TextBlock Text="Find by account number or customer name"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            </StackPanel>

                            <TextBox x:Name="SearchAllAccountsTextBox"
                                     Grid.Column="1"
                                     Text="{Binding GlobalAccountSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{DynamicResource L_Search_Watermark}"
                                     VerticalAlignment="Center"
                                     KeyDown="SearchAllAccountsBox_KeyDown"/>

                            <Button Grid.Column="2"
                                    Classes="Secondary"
                                    VerticalAlignment="Center"
                                    Click="SearchAllAccounts_Click">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource Icon_Search}" Width="14" Height="14" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource L_Common_Search}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Classes="Card" Padding="28" IsVisible="{Binding IsLoading}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource L_Dash_Loading}" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <ProgressBar IsIndeterminate="True" Width="220"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Classes="Skeleton" Height="96"/>
                        <Border Grid.Column="1" Classes="Skeleton" Height="96"/>
                        <Border Grid.Column="2" Classes="Skeleton" Height="96"/>
                        <Border Grid.Column="3" Classes="Skeleton" Height="96"/>
                    </Grid>
                    <Border Classes="Skeleton" Height="180"/>
                </StackPanel>
            </Border>

            <StackPanel Spacing="18" IsVisible="{Binding !IsLoading}">
                <!-- License Grace Period / Expiring Soon Alert Banner -->
                <Border Classes="Card"
                        Padding="0"
                        Background="{DynamicResource DangerTintBrush}"
                        BorderBrush="{DynamicResource DangerEdgeBrush}"
                        BorderThickness="1"
                        IsVisible="{Binding HasLicenseNotice}">
                    <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="0">
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="14,12">
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="12"
                                    Background="{DynamicResource AppCardBackgroundBrush}"
                                    BorderBrush="{StaticResource ErrorBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource Icon_Shield}"
                                          Width="18"
                                          Height="18"
                                          Foreground="{StaticResource ErrorBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="License Renewal Notice"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TintTextBrush}"/>
                                <TextBlock Text="{Binding LicenseWarningMessage}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TintTextBrush}"/>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Grid.Column="2"
                                   Margin="0,12,14,4"
                                   VerticalAlignment="Center">
                            <Button Classes="Primary"
                                    Padding="14,8"
                                    Click="NavigateToSettings_Click"
                                    Content="Manage License"
                                    Margin="0,0,8,8"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Classes="Card"
                        Padding="0"
                        Background="{DynamicResource WarningTintBrush}"
                        BorderBrush="{DynamicResource WarningEdgeBrush}"
                        BorderThickness="1"
                        IsVisible="{Binding HasNewAccountsMissingAslaasNotice}">
                    <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="0">
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="14,12">
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="12"
                                    Background="{DynamicResource AppCardBackgroundBrush}"
                                    BorderBrush="{StaticResource WarningBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="!"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L_Dash_AslaasReminderTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TintTextBrush}"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource TintTextBrush}">
                                    <Run Text="{Binding NewAccountsMissingAslaasCount}"/>
                                    <Run Text="{DynamicResource L_Dash_AslaasReminderBody}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Grid.Column="2"
                                   Margin="0,12,14,4"
                                   VerticalAlignment="Center">
                                <Button Classes="Primary"
                                        Padding="14,8"
                                        Command="{Binding UpdateNewAccountAslaasCommand}"
                                        IsEnabled="{Binding !IsBusy}"
                                        Content="{DynamicResource L_Dash_UpdateAslaasNow}"
                                        Margin="0,0,8,8"/>
                                <Button Classes="Secondary"
                                        Padding="14,8"
                                        Tag="new-accounts"
                                        Click="OpenSegment_Click"
                                        Content="{DynamicResource L_Common_ViewAccounts}"
                                        Margin="0,0,0,8"/>
                            </WrapPanel>
                    </Grid>
                </Border>

                <Border Classes="Card"
                        Padding="0"
                        Tag="{Binding RdCertificateRenewalTag}">
                    <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="0">
                        <StackPanel Grid.Column="1" Spacing="4" Margin="14,12">
                                <TextBlock Text="Postal RD Certificate Renewal"
                                           Classes="Kicker"/>
                                <TextBlock Text="{Binding RdCertificateRenewalHeadline}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TintTextBrush}"/>
                                <TextBlock Text="{Binding RdCertificateRenewalMessage}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TintTextBrush}"/>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Classes="DashboardBadge"
                                    Margin="0,12,14,12"
                                    VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding RdCertificateRenewalCountdown}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding RdCertificateRenewalDateDisplay}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                    </Grid>
                </Border>



                <Border Classes="DefaultSummaryCard Stagger Delay1" Padding="24">
                    <StackPanel Spacing="24">
                        <!-- HEADER SECTION -->
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Top">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="PORTFOLIO OVERVIEW" Classes="Kicker" LetterSpacing="1.2" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="Complete Active RD Portfolio" FontSize="22" FontWeight="Bold" LetterSpacing="-0.4"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <Button Classes="Secondary" Padding="16,8" Click="SearchDefaultSummary_Click" Content="Search Accounts"/>
                                <Button Classes="Primary" Padding="20,8" Click="OpenDefaultSummary_Click" Content="View All Accounts"/>
                            </StackPanel>
                        </Grid>

                        <!-- METRICS SECTION -->
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="32">
                            <!-- Metric 1 -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <Border Classes="IconChip" Background="{DynamicResource InfoTintBrush}" HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <PathIcon Data="{StaticResource Icon_User}" Width="16" Height="16" Foreground="{DynamicResource InfoBrush}"/>
                                </Border>
                                <TextBlock Text="Total Active Accounts" Classes="Kicker"/>
                                <TextBlock Text="{Binding TotalAccounts}" FontSize="30" FontWeight="Bold" LetterSpacing="-0.8"/>
                            </StackPanel>
                            
                            <!-- Metric 2 -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <Border Classes="IconChip" Background="{DynamicResource InfoTintBrush}" HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <PathIcon Data="{StaticResource Icon_Database}" Width="16" Height="16" Foreground="{DynamicResource InfoBrush}"/>
                                </Border>
                                <TextBlock Text="Total Portfolio Size" Classes="Kicker"/>
                                <TextBlock FontSize="30" FontWeight="Bold" LetterSpacing="-0.8">
                                    <Run Text="Rs. "/><Run Text="{Binding TotalAmount, StringFormat=N0}"/>
                                </TextBlock>
                            </StackPanel>
                            
                            <!-- Metric 3 -->
                            <StackPanel Grid.Column="2" Spacing="4">
                                <Border Classes="IconChip" Background="{DynamicResource WarningTintBrush}" HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <PathIcon Data="{StaticResource Icon_Clock}" Width="16" Height="16" Foreground="{DynamicResource WarningBrush}"/>
                                </Border>
                                <TextBlock Text="Total Due Collection" Classes="Kicker"/>
                                <TextBlock FontSize="30" FontWeight="Bold" LetterSpacing="-0.8">
                                    <Run Text="{Binding PendingThisMonthCount}" /><Run Text=" accounts" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </TextBlock>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}">
                                    <Run Text="Rs. "/><Run Text="{Binding PendingThisMonthAmount, StringFormat=N0}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Metric 4 -->
                            <StackPanel Grid.Column="3" Spacing="4">
                                <Border Classes="IconChip" Background="{DynamicResource SuccessTintBrush}" HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <PathIcon Data="{StaticResource Icon_Check}" Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                                <TextBlock Text="Deposited This Month" Classes="Kicker"/>
                                <TextBlock FontSize="30" FontWeight="Bold" LetterSpacing="-0.8">
                                    <Run Text="Rs. "/><Run Text="{Binding FirstHalfDepositedWindowAmount, StringFormat=N0}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- Subtle Divider -->
                        <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,8" Opacity="0.3"/>

                        <!-- AUTOMATIONS SECTION -->
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="AUTOMATED ACTIONS" Classes="Kicker" LetterSpacing="1.2" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBlock Text="1-Click PDF export &amp; WhatsApp dispatch for bulk collection reminders." Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock Text="OWNER NUMBER:" Classes="Kicker" VerticalAlignment="Center"/>
                                    <TextBox Width="180" Text="{Binding AgentPhoneNumber}" PlaceholderText="e.g. 919876543210"/>
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,4,0,0">
                                <!-- 15th Deadline Auto -->
                                <Button Classes="Secondary" Margin="0,0,10,10" Padding="14,9" Tag="pending-first-half" Click="SmartAutomation_Click"
                                        ToolTip.Tip="Generate 15th deadline due list PDF, copy to clipboard, and open WhatsApp">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <PathIcon Grid.Column="0" Data="{StaticResource Icon_Calendar}" Width="15" Height="15" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Remind 15th Deadline" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Classes="CountPill"><TextBlock Text="{Binding FirstHalfDeadlineCount}"/></Border>
                                    </Grid>
                                </Button>
                                
                                <!-- Month End Auto -->
                                <Button Classes="Secondary" Margin="0,0,10,10" Padding="14,9" Tag="pending-second-half" Click="SmartAutomation_Click"
                                        ToolTip.Tip="Generate month-end due list PDF, copy to clipboard, and open WhatsApp">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <PathIcon Grid.Column="0" Data="{StaticResource Icon_Clock}" Width="15" Height="15" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Remind Month-End" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Classes="CountPill"><TextBlock Text="{Binding SecondHalfDeadlineCount}"/></Border>
                                    </Grid>
                                </Button>

                                <!-- Rebate Upsell Auto -->
                                <Button Classes="Secondary" Margin="0,0,10,10" Padding="14,9" Tag="rebate-upsell" Click="SmartAutomation_Click"
                                        ToolTip.Tip="Generate advance rebate eligibility list PDF, copy to clipboard, and open WhatsApp">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <PathIcon Grid.Column="0" Data="{StaticResource Icon_Sparkle}" Width="15" Height="15" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Pitch 6-Month Rebates" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Classes="CountPill"><TextBlock Text="{Binding RebateUpsellCount}"/></Border>
                                    </Grid>
                                </Button>

                                <!-- Critical Discontinuation Auto -->
                                <Button Classes="Secondary" Margin="0,0,10,10" Padding="14,9" Tag="critical-discontinuation" Click="SmartAutomation_Click"
                                        ToolTip.Tip="Generate discontinuation warning list PDF, copy to clipboard, and open WhatsApp">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <PathIcon Grid.Column="0" Data="{StaticResource Icon_Alert}" Width="15" Height="15" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Warn Discontinuations" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Classes="CountPill"><TextBlock Text="{Binding CriticalDiscontinuationCount}"/></Border>
                                    </Grid>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="Card" Padding="16" IsVisible="{Binding HasUpdateStatus}">
                    <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Border>

                <Border Classes="SectionCard Stagger Delay2" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="SubHeader">
                            <Run Text="{DynamicResource L_Dash_HalfMonthTitle}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding HalfMonthTitleSuffix}"/>
                        </TextBlock>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                            <Border Grid.Row="0" Grid.Column="0" Classes="StatTile TintDanger">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_FirstHalfPending}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding FirstHalfPendingWindowCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding FirstHalfPendingWindowAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-first-half" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-first-half" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-first-half" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Classes="StatTile TintWarning">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_SecondHalfPending}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding SecondHalfPendingWindowCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding SecondHalfPendingWindowAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-second-half" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-second-half" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-second-half" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Classes="StatTile TintSuccess">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_FirstHalfDeposited}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding FirstHalfDepositedWindowCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding FirstHalfDepositedWindowAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="deposited-first-half" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="deposited-first-half" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="deposited-first-half" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Classes="StatTile TintInfo">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_SecondHalfDeposited}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding SecondHalfDepositedWindowCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding SecondHalfDepositedWindowAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="deposited-second-half" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="deposited-second-half" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="deposited-second-half" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="SectionCard Stagger Delay3" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Agent Insights (Opportunities &amp; Risks)" Classes="SubHeader"/>

                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                            <!-- Row 0: Rebate Upsell Prospects -->
                            <Border Grid.Row="0" Grid.Column="0" Classes="StatTile TintSuccess">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="Rebate Upsell Prospects" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding RebateUpsellCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="Prime for 6-month advance pitch" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="rebate-upsell" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Row 0: Critical Discontinuation -->
                            <Border Grid.Row="0" Grid.Column="1" Classes="StatTile TintDanger">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="Last Chance (5-6 Mo Overdue)" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding CriticalDiscontinuationCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="About to be permanently discontinued" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="critical-discontinuation" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Row 0: Defaulters -->
                            <Border Grid.Row="0" Grid.Column="2" Classes="StatTile TintWarning">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="Defaulter Accounts (4+ Mo)" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding DefaulterAccountsCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="Requires Revival Fee" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="defaulters" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Row 1: VIP Customers -->
                            <Border Grid.Row="1" Grid.Column="0" Classes="StatTile TintSuccess">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="VIP Accounts (High Value)" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding VipAccountsCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding VipAccountsAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="vip-accounts" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            
                            <!-- Row 1: At-Risk Customers -->
                            <Border Grid.Row="1" Grid.Column="1" Classes="StatTile TintWarning">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="At Risk (1-3 Mo Overdue)" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding AtRiskAccountsCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="Monthly penalties applying" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="at-risk-accounts" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Row 1: Commission Forecast -->
                            <Border Grid.Row="1" Grid.Column="2" Classes="StatTile TintInfo">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="Pending Commission Forecast" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue" Foreground="{DynamicResource SuccessBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding PendingCommissionForecast, StringFormat=N0}"/>
                                    </TextBlock>
                                    <TextBlock Text="Estimated 4% of Pending Month" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Row 2: Eligible for Loan -->
                            <Border Grid.Row="2" Grid.Column="0" Classes="StatTile TintInfo">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="Eligible for 50% Loan" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding EligibleForLoanCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="12+ Installments Paid" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="loan-eligible" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Row 2: Premature Closure -->
                            <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="StatTile TintInfo">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="Premature Closure Prospects" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding EligibleForPrematureClosureCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="36+ Installments Paid" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="premature-closure" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="SectionCard Stagger Delay4" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource L_Dash_ActionCenter}" Classes="SubHeader"/>

                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                            <Border Grid.Row="0" Grid.Column="0" Classes="StatTile TintSuccess">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_PendingMonth}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding PendingThisMonthCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding PendingThisMonthAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-month" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-month" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="pending-month" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Classes="StatTile TintInfo">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_NextMonthCollection}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding NextMonthCollectionCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding NextMonthCollectionAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="next-month" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="next-month" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="next-month" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="2" Classes="StatTile TintWarning">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_AdvancePaid}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding AdvancedPaidCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding AdvancedPaidAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="advanced-paid" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="advanced-paid" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="advanced-paid" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Classes="StatTile TintInfo">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Classes="TileDot"/>
                                            <TextBlock Text="{DynamicResource L_Dash_NewAccountsRecent}"
                                                       Classes="TileTitle"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource SuccessTintBrush}"
                                                BorderBrush="{StaticResource SuccessBrush}"
                                                BorderThickness="1"
                                                CornerRadius="999"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasNewAccountsRibbon}">
                                            <TextBlock Text="NEW"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource SuccessBrush}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding NewAccounts30DaysCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding NewAccounts30DaysAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="new-accounts" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="new-accounts" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="new-accounts" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Classes="StatTile TintWarning">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_AboutToFreeze}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding AboutToFreezeCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding AboutToFreezeAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="freeze-risk" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="freeze-risk" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="freeze-risk" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="2" Classes="StatTile TintDanger">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_Due30Days}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding AccountsDueSoon.Count}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="Requires immediate action" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="due-soon" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="due-soon" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="due-soon" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Shift Matured to Row 3 -->
                            <Border Grid.Row="3" Grid.Column="0" Classes="StatTile TintDanger">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_MaturedAccounts}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding MaturedCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding MaturedAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="matured" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="matured" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="matured" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Classes="StatTile TintDanger">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_ClosedAccounts}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding ClosedAccountsCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding ClosedAccountsAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="closed-accounts" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="closed-accounts" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="closed-accounts" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="1" Classes="StatTile TintWarning">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="About To Mature" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding AboutToMatureCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding AboutToMatureAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="about-to-mature" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="about-to-mature" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="about-to-mature" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="2" Classes="StatTile TintInfo">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="TileDot"/>
                                        <TextBlock Text="{DynamicResource L_Dash_ExtendedAccounts}" Classes="TileTitle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="TileValue">
                                        <Run Text="{Binding ExtendedAccountsCount}"/>
                                        <Run Text="{DynamicResource L_Dash_AccountsSuffix}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Rs. "/><Run Text="{Binding ExtendedAccountsAmount, StringFormat=N0}"/>
                                    </TextBlock>
                                    <WrapPanel>
                                        <Button Classes="Secondary" Padding="10,6" Tag="extended-accounts" Click="OpenSegment_Click" Content="{DynamicResource L_Common_ViewAccounts}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="extended-accounts" Click="SearchSegment_Click" Content="{DynamicResource L_Common_Search}" Margin="0,0,8,8"/>
                                        <Button Classes="Secondary" Padding="10,6" Tag="extended-accounts" Click="PrintSegment_Click" Content="{DynamicResource L_Common_Print}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="16">
                    <Border Grid.Column="0" Classes="Card Stagger Delay5">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{DynamicResource L_Dash_PortfolioRiskSplit}" Classes="SubHeader"/>
                            <TextBlock Text="{DynamicResource L_Dash_PortfolioRiskHint}"
                                       Classes="SectionLead"
                                       Margin="0,-6,0,0"/>
                            <lvc:PieChart Series="{Binding CategorySeries}"
                                          Height="260"
                                          LegendPosition="Hidden"
                                          LegendTextPaint="{Binding ChartLegendTextPaint}"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,8">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Default" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,8">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Mature" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,8">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource ErrorBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Freeze Risk" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,8">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Advanced" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentPinkBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="New" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="Card Stagger Delay6">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{DynamicResource L_Dash_MonthlyWorkloadTrend}" Classes="SubHeader"/>
                            <TextBlock Text="{DynamicResource L_Dash_MonthlyWorkloadHint}"
                                       Classes="SectionLead"
                                       Margin="0,-6,0,0"/>
                            <lvc:CartesianChart Series="{Binding RevenueSeries}"
                                                XAxes="{Binding RevenueXAxes}"
                                                YAxes="{Binding RevenueYAxes}"
                                                Height="260"
                                                LegendPosition="Hidden"
                                                LegendTextPaint="{Binding ChartLegendTextPaint}"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,0">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Default accounts" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Earnings (Rs.)" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
